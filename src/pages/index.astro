      <div class="now-item reveal reveal-delay-4">
        <div class="now-item-label">Open to</div>
        <p class="now-item-text">Conversations. If you're working on something hard and want to talk through it, reach out.</p>
      </div>
      <div class="now-item reveal reveal-delay-4" style="background:var(--color-accent-dim)">
        <div class="now-item-label" style="color:var(--color-accent)">Contact</div>
        <p class="now-item-text"><a href="mailto:shahp0021@gmail.com" style="color:var(--color-accent);text-decoration:none">shahp0021@gmail.com</a></p>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer>
  <div>
    <div class="footer-kicker">Open channels</div>
    <div class="footer-title">Build, research, ship.</div>
    <div class="footer-copy">&copy; 2026 Prashant Shah</div>
  </div>
  <div class="footer-links">
    <a href="https://github.com/Prashant002-1" target="_blank" rel="noopener" data-mark="GH">GitHub</a>
    <a href="https://www.linkedin.com/in/prashant210/" target="_blank" rel="noopener" data-mark="IN">LinkedIn</a>
    <a href="mailto:shahp0021@gmail.com" data-mark="MAIL">Email</a>
    <a href="/resume.pdf" data-mark="PDF">Resume</a>
  </div>
</footer>

<script is:inline>
// ── Scroll reveal ──────────────────────────
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
setTimeout(() => {
  document.querySelectorAll('#hero .reveal').forEach(el => el.classList.add('visible'));
}, 100);

// ── Custom cursor ──────────────────────────
const cursorDot = document.getElementById('cursorDot');
const cursorRing = document.getElementById('cursorRing');
if (!window.matchMedia('(hover: none)').matches) {
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    cursorDot.style.left = mx + 'px'; cursorDot.style.top = my + 'px';
  });
  (function animRing() {
    rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
    cursorRing.style.left = rx + 'px'; cursorRing.style.top = ry + 'px';
    requestAnimationFrame(animRing);
  })();
  function setCursor(ringClass, dotClass) {
    cursorRing.className = 'cursor-ring' + (ringClass ? ' ' + ringClass : '');
    cursorDot.className  = 'cursor-dot'  + (dotClass  ? ' ' + dotClass  : '');
  }
  function bindCursor(selector, ringClass, dotClass) {
    document.querySelectorAll(selector).forEach(el => {
      el.addEventListener('mouseenter', () => setCursor(ringClass, dotClass));
      el.addEventListener('mouseleave', () => setCursor('', ''));
    });
  }
  bindCursor('.hero-name-row, .hero-name-block', 'cur-lens', 'cur-lens');
  bindCursor('.nav-links a', 'cur-line', 'cur-line');
  bindCursor('.github-heatmap, .hm-cell', 'cur-grid', 'cur-grid');
  bindCursor('.work-card, .work-featured', 'cur-expand', 'cur-expand');
  document.querySelectorAll('.card-expand-btn').forEach(btn => {
    btn.addEventListener('mouseenter', () => setCursor('cur-close', 'cur-close'));
    btn.addEventListener('mouseleave', () => setCursor('cur-expand', 'cur-expand'));
  });
  bindCursor('.stat-value, .research-stat', 'cur-square', 'cur-square');
  bindCursor('.cta-primary, .cta-secondary', 'cur-cta', 'cur-cta');
  bindCursor('.footer-links a, a[target="_blank"]', 'cur-arrow', 'cur-arrow');
  bindCursor('.now-item', 'cur-live', 'cur-live');
}

// ── Magnetic CTAs ──────────────────────────
document.querySelectorAll('.cta-primary, .cta-secondary').forEach(el => {
  el.addEventListener('mousemove', e => {
    const r = el.getBoundingClientRect();
    const dx = (e.clientX - (r.left + r.width / 2)) * 0.28;
    const dy = (e.clientY - (r.top + r.height / 2)) * 0.28;
    el.style.transform = `translate(${dx}px,${dy}px)`;
  });
  el.addEventListener('mouseleave', () => { el.style.transform = 'translate(0,0)'; });
});

// ── Nav active section ─────────────────────
const navLinks = document.querySelectorAll('.nav-links a[href^="#"]');
new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
    }
  });
}, { rootMargin: '-40% 0px -55% 0px' }).observe
  && document.querySelectorAll('section[id]').forEach(s =>
      new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting)
            navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
        });
      }, { rootMargin: '-40% 0px -55% 0px' }).observe(s)
    );

// ── Card expand ────────────────────────────
document.querySelectorAll('.card-expand-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const card = btn.closest('.work-card, .work-featured');
    const isOpen = card.classList.toggle('expanded');
    const label = btn.querySelector('.exp-label');
    if (label) label.textContent = isOpen ? 'less' : 'more detail';
  });
});

// ── Research count-up ──────────────────────
function countUp(el, target, duration) {
  const isFloat = target < 1;
  let start = null;
  el.classList.add('counting');
  function step(ts) {
    if (!start) start = ts;
    const p = Math.min((ts - start) / duration, 1);
    const ease = 1 - Math.pow(1 - p, 3);
    el.textContent = isFloat ? (target * ease).toFixed(3) : Math.floor(target * ease).toLocaleString();
    if (p < 1) requestAnimationFrame(step); else el.classList.remove('counting');
  }
  requestAnimationFrame(step);
}
let statsFired = false;
const statEls = document.querySelectorAll('.research-stat .stat-value');
new IntersectionObserver(entries => {
  if (!statsFired && entries.some(e => e.isIntersecting)) {
    statsFired = true;
    if (statEls[0]) countUp(statEls[0], 1600, 1400);
    if (statEls[1]) countUp(statEls[1], 0.037, 1400);
  }
}, { threshold: 0.5 }).observe(statEls[0] || document.body);

// ── Status strip clock ─────────────────────
const clockEl = document.getElementById('stripClock');
function tick() {
  if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
}
tick(); setInterval(tick, 1000);
setTimeout(() => { const s = document.getElementById('now-strip'); if (s) s.classList.add('visible'); }, 4000);

// ── GitHub heatmap ─────────────────────────
async function loadHeatmap() {
  const container = document.getElementById('githubHeatmap');
  if (!container) return;
  const fallback = () => {
    container.innerHTML = '';
    [0,1,0,2,1,0,3,2,1,0,2,1,4,2,0,1,3,2,1,0,2,3,1,0,2,1,3,2].forEach(peak => {
      const col = document.createElement('div'); col.className = 'hm-col';
      for (let d = 0; d < 7; d++) {
        const cell = document.createElement('div'); cell.className = 'hm-cell';
        const lvl = Math.max(0, peak - Math.floor(Math.random() * 2));
        if (lvl > 0) cell.setAttribute('data-level', Math.min(lvl, 4));
        col.appendChild(cell);
      }
      container.appendChild(col);
    });
  };
  try {
    const res = await fetch('https://github-contributions-api.jogruber.de/v4/Prashant002-1?y=2026');
    if (!res.ok) { fallback(); return; }
    const data = await res.json();
    const contribs = (data.contributions || []).filter(d => d.date && d.date.startsWith('2026'));
    if (!contribs.length) { fallback(); return; }
    container.innerHTML = '';
    let week = [], weeks = [];
    contribs.forEach((d, i) => {
      week.push(d);
      if (week.length === 7 || i === contribs.length - 1) { weeks.push(week); week = []; }
    });
    weeks.slice(-28).forEach(wk => {
      const col = document.createElement('div'); col.className = 'hm-col';
      wk.forEach(day => {
        const cell = document.createElement('div'); cell.className = 'hm-cell';
        if (day.level > 0) cell.setAttribute('data-level', day.level);
        cell.title = `${day.date}: ${day.count} contribution${day.count !== 1 ? 's' : ''}`;
        col.appendChild(cell);
      });
      container.appendChild(col);
    });
    const total = contribs.reduce((s, d) => s + (d.count || 0), 0);
    const lbl = document.getElementById('githubLabel');
    if (lbl && lbl.firstChild) lbl.firstChild.textContent = `${total} contributions in 2026 `;
  } catch { fallback(); }
}
loadHeatmap();
</script>

</body>
</html>
