---
type Contribution = {
  date: string;
  count: number;
  level: number;
};

const githubYear = "2026";
const todayIso = new Date().toISOString().slice(0, 10);
const githubResponse = await fetch(`https://github-contributions-api.jogruber.de/v4/Prashant002-1?y=${githubYear}`);

if (!githubResponse.ok) {
  throw new Error(`GitHub contributions request failed: ${githubResponse.status}`);
}

const githubData = await githubResponse.json();
const githubContributions: Contribution[] = (githubData.contributions || [])
  .filter((day: Contribution) => day.date?.startsWith(githubYear));

const githubTotal = githubContributions.reduce((sum, day) => day.date <= todayIso ? sum + (day.count || 0) : sum, 0);
const githubWeeks: Contribution[][] = [];

for (let i = 0; i < githubContributions.length; i += 7) {
  githubWeeks.push(githubContributions.slice(i, i + 7));
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Prashant Shah, software engineer and data systems builder." />
  <meta name="theme-color" content="#F4F5F7" />
  <meta property="og:title" content="Prashant Shah" />
  <meta property="og:description" content="Software engineer and data systems builder." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>Prashant Shah</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      color-scheme: light;
      --font-heading: 'Sora', 'Helvetica Neue', sans-serif;
      --font-body:    'Source Serif 4', Georgia, serif;
      --font-mono:    'JetBrains Mono', monospace;

      --color-bg:       #F4F5F7;
      --color-surface:  #FFFFFF;
      --color-panel:    rgba(255,255,255,0.82);
      --color-panel-strong: rgba(255,255,255,0.96);
      --color-card:     rgba(255,255,255,0.86);
      --color-card-strong: rgba(255,255,255,0.94);
      --color-card-hover: rgba(240,239,245,0.92);
      --color-text:     #181522;
      --color-muted:    #514C5D;
      --color-faint:    #686272;
      --color-border:   #C9C5D1;
      --color-border-soft: rgba(24,21,34,0.13);
      --color-shadow:   rgba(45,35,70,0.11);

      --color-coral:    #C83D50;
      --color-coral-hover: #A82E42;
      --color-coral-glow: rgba(200,61,80,0.18);
      --color-coral-dim: rgba(200,61,80,0.08);

      --color-cyan:     #087A76;
      --color-cyan-glow: rgba(8,122,118,0.18);
      --color-cyan-dim: rgba(8,122,118,0.07);

      --color-gold:     #896100;
      --color-gold-glow: rgba(137,97,0,0.17);
      --color-gold-dim: rgba(137,97,0,0.07);

      --color-purple:   #6547B4;
      --color-purple-glow: rgba(101,71,180,0.18);
      --color-purple-dim: rgba(101,71,180,0.07);

      --color-rose:     #B82E62;
      --color-rose-dim: rgba(184,46,98,0.08);

      --max-content: 1100px;
      --transition: 180ms ease;
    }

    html { scroll-behavior: smooth; }
    html.lenis {
      height: auto;
      scroll-behavior: auto;
    }
    html.lenis body { height: auto; }
    .lenis:not(.lenis-autoToggle).lenis-stopped { overflow: clip; }
    .lenis [data-lenis-prevent],
    .lenis [data-lenis-prevent-wheel],
    .lenis [data-lenis-prevent-touch],
    .lenis [data-lenis-prevent-vertical],
    .lenis [data-lenis-prevent-horizontal] {
      overscroll-behavior: contain;
    }
    .lenis.lenis-smooth iframe { pointer-events: none; }
    body {
      font-family: var(--font-body);
      background: var(--color-bg);
      color: var(--color-text);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      padding-bottom: 86px;
      isolation: isolate;
      position: relative;
    }

    .ambient-field {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -5;
      background: var(--color-bg);
    }

    /* Hide default cursor when custom is active */
    @media (hover: hover) and (pointer: fine) {
      html, body, body *, body *::before, body *::after {
        cursor: none !important;
      }
    }
    @media (hover: none), (pointer: coarse) {
      .cursor-dot, .cursor-ring { display: none; }
    }
    ::selection { background: rgba(200,61,80,0.2); color: var(--color-text); }
    :focus-visible { outline: 1px solid var(--color-coral); outline-offset: 3px; }

    /* ── Orb navigation ─────────────────────── */
    .orb-nav {
      --pull-x: 0px; --pull-y: 0px;
      --orb-x: calc(100vw - 68px); --orb-y: 34px;
      position: fixed; top: 0; left: 0; z-index: 260;
      width: 34px; height: 34px;
      display: grid; place-items: center;
      transform: translate3d(var(--orb-x), var(--orb-y), 0);
      transition: transform 260ms cubic-bezier(0.16,1,0.3,1);
    }
    .orb-float {
      display: grid; place-items: center;
      animation: orb-float 4.8s ease-in-out infinite;
    }
    .orb-button {
      position: relative; width: 28px; height: 28px;
      border-radius: 50%;
      border: 1px solid rgba(200,61,80,0.5);
      background:
        radial-gradient(circle at 34% 28%, rgba(255,213,113,0.34), rgba(200,61,80,0.18) 28%, transparent 48%),
        linear-gradient(135deg, rgba(200,61,80,0.42), rgba(63,42,96,0.92));
      box-shadow:
        inset 0 1px 4px rgba(255,255,255,0.1),
        inset 0 -8px 16px rgba(0,0,0,0.3),
        0 0 20px var(--color-coral-glow);
      backdrop-filter: blur(10px) saturate(1.3);
      -webkit-backdrop-filter: blur(10px) saturate(1.3);
      transform: translate3d(var(--pull-x), var(--pull-y), 0);
      transition: transform 120ms ease-out, opacity 150ms ease, scale 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
    }
    .orb-button::before {
      content: ''; position: absolute; inset: 7px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.12);
      opacity: 0.9;
    }
    .orb-button::after {
      content: ''; position: absolute;
      width: 5px; height: 5px;
      top: 7px; left: 8px;
      border-radius: 50%;
      background: rgba(224,164,46,0.92);
      box-shadow: 0 0 8px var(--color-gold-glow);
    }
    .orb-trigger {
      position: absolute; inset: -42px;
      border: 0; border-radius: 999px;
      background: transparent; padding: 0;
    }
    .orb-trigger:focus-visible {
      outline: 1px solid rgba(200,61,80,0.8);
      outline-offset: -28px;
    }
    .orb-label {
      position: absolute; top: 50%; right: 46px;
      transform: translateY(-50%);
      font-family: var(--font-heading); font-size: 9.5px; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-muted);
      padding: 5px 10px 5px 12px;
      border: 1px solid var(--color-border-soft); border-radius: 999px;
      background: rgba(255,255,255,0.84);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      white-space: nowrap; pointer-events: none;
      transition: color 150ms ease, border-color 150ms ease, opacity 150ms ease;
    }
    .orb-nav:hover .orb-label,
    .orb-nav.pulling .orb-label {
      color: var(--color-text);
      border-color: rgba(200,61,80,0.45);
    }
    .orb-nav.open .orb-label { opacity: 0; }
    .orb-nav.hero-mode .orb-label {
      top: -36px; right: 50%; bottom: auto;
      transform: translateX(50%);
    }
    .orb-nav:focus-within .orb-menu {
      opacity: 1; pointer-events: auto;
      transform: scale(1) translate3d(0, 0, 0);
    }
    .orb-nav:focus-within .orb-label { opacity: 0; }
    .orb-nav.pulling .orb-button {
      border-color: rgba(200,61,80,0.8);
      box-shadow: inset 0 1px 4px rgba(255,255,255,0.12), inset 0 -8px 16px rgba(0,0,0,0.3), 0 0 30px var(--color-coral-glow);
    }
    .orb-nav.open .orb-button {
      opacity: 0; scale: 0.22;
    }
    .orb-nav.collapsing .orb-button {
      scale: 1.18; opacity: 0.78;
    }
    .orb-menu {
      position: absolute; top: -8px; right: -8px;
      width: 190px; padding: 12px;
      border: 1px solid var(--color-border-soft);
      border-radius: 18px;
      background: rgba(255,255,255,0.94);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      box-shadow: 0 8px 18px var(--color-shadow);
      transform-origin: 88% 16%;
      transform: scale(0.18) translate3d(18px, -18px, 0);
      opacity: 0; pointer-events: none;
      transition: opacity 140ms ease, transform 180ms cubic-bezier(0.16,1,0.3,1);
    }
    .orb-nav.collapsing .orb-menu {
      opacity: 0;
      transform: scale(0.14) translate3d(18px, -18px, 0);
      transition-duration: 150ms;
    }
    .orb-nav.open .orb-menu {
      opacity: 1; pointer-events: auto;
      transform: scale(1) translate3d(0, 0, 0);
    }
    .orb-menu a {
      display: flex; align-items: center;
      min-height: 34px; padding: 0 28px 0 10px;
      border-radius: 10px;
      font-family: var(--font-heading); font-size: 13px; font-weight: 600;
      color: var(--color-muted); text-decoration: none;
      transition: background 130ms ease, color 130ms ease, transform 130ms ease;
    }
    .orb-menu a:hover,
    .orb-menu a.active {
      color: var(--color-text);
      background: var(--color-coral-dim);
      transform: translateX(2px);
    }
    .orb-nav.hero-mode .orb-menu {
      top: -172px; left: -142px; right: auto;
      width: 318px; height: auto; padding: 14px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(242,240,247,0.94));
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      opacity: 0; pointer-events: none;
      transition: opacity 200ms ease;
    }
    .orb-nav.hero-mode.open .orb-menu,
    .orb-nav.hero-mode:focus-within .orb-menu {
      opacity: 1; pointer-events: auto;
    }
    .orb-nav.hero-mode.collapsing .orb-menu {
      opacity: 0; pointer-events: none;
    }
    .orb-nav.hero-mode .orb-menu a {
      position: relative; min-height: 36px; padding: 0 12px;
      border: 1px solid var(--color-border-soft);
      background: rgba(255,255,255,0.68); justify-content: space-between;
      transform: scale(0); opacity: 0;
      transition: transform 300ms cubic-bezier(0.16,1,0.3,1), opacity 200ms ease;
    }
    .orb-nav.hero-mode .orb-menu a:nth-child(1) { transition-delay: 200ms; }
    .orb-nav.hero-mode .orb-menu a:nth-child(2) { transition-delay: 160ms; }
    .orb-nav.hero-mode .orb-menu a:nth-child(3) { transition-delay: 120ms; }
    .orb-nav.hero-mode .orb-menu a:nth-child(4) { transition-delay: 80ms; }
    .orb-nav.hero-mode .orb-menu a:nth-child(5) { transition-delay: 40ms; }
    .orb-nav.hero-mode .orb-menu a:nth-child(6) { transition-delay: 0ms; }
    .orb-nav.hero-mode.open .orb-menu a,
    .orb-nav.hero-mode:focus-within .orb-menu a {
      transform: scale(1); opacity: 1;
    }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(1) { transition-delay: 0ms; }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(2) { transition-delay: 40ms; }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(3) { transition-delay: 80ms; }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(4) { transition-delay: 120ms; }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(5) { transition-delay: 160ms; }
    .orb-nav.hero-mode.open .orb-menu a:nth-child(6) { transition-delay: 200ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a {
      transform: scale(0); opacity: 0;
    }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(1) { transition-delay: 200ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(2) { transition-delay: 160ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(3) { transition-delay: 120ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(4) { transition-delay: 80ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(5) { transition-delay: 40ms; }
    .orb-nav.hero-mode.collapsing .orb-menu a:nth-child(6) { transition-delay: 0ms; }
    .orb-nav.hero-mode .orb-menu a:hover,
    .orb-nav.hero-mode .orb-menu a.active {
      transform: scale(1) translateY(-1px);
      border-color: rgba(200,61,80,0.25);
    }
    @keyframes orb-float {
      0%, 100% { transform: translateY(-2px); }
      50% { transform: translateY(5px); }
    }
    @keyframes orb-heartbeat {
      0%, 100% { transform: scale(1); }
      8% { transform: scale(1.14); }
      16% { transform: scale(1); }
      24% { transform: scale(1.08); }
      32% { transform: scale(1); }
    }
    @keyframes orb-ripple {
      0%, 100% { box-shadow: 0 0 10px var(--color-coral-glow), 0 0 0 0 rgba(200,61,80,0.3); }
      8% { box-shadow: 0 0 18px var(--color-coral-glow), 0 0 0 14px rgba(200,61,80,0); }
      16% { box-shadow: 0 0 10px var(--color-coral-glow), 0 0 0 0 rgba(200,61,80,0); }
      24% { box-shadow: 0 0 14px var(--color-coral-glow), 0 0 0 8px rgba(200,61,80,0); }
      32% { box-shadow: 0 0 10px var(--color-coral-glow), 0 0 0 0 rgba(200,61,80,0); }
    }
    .orb-nav.hero-mode .orb-float {
      animation: orb-heartbeat 2.2s ease-in-out infinite;
    }
    .orb-nav.hero-mode .orb-button {
      animation: orb-ripple 2.2s ease-out infinite;
    }

    /* ── Hero ────────────────────────────────── */
    #hero {
      min-height: 100dvh; display: flex; flex-direction: column;
      justify-content: flex-end; padding: 0 48px 118px;
      position: relative; overflow: hidden;
    }
    .hero-canvas { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .hero-layout {
      display: grid; grid-template-columns: 1fr 260px;
      gap: 56px; align-items: flex-end; margin-bottom: 32px;
    }
    .hero-left { display: flex; flex-direction: column; }
    .hero-eyebrow {
      font-family: var(--font-heading); font-size: 11px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-cyan);
      margin-bottom: 20px;
    }
    .hero-name-block { position: relative; }
    .hero-name-row {
      display: table; line-height: 0.88; font-family: var(--font-heading);
      font-weight: 800; letter-spacing: -0.05em;
      font-size: clamp(4.4rem, 11vw, 10.5rem);
      color: var(--color-text);
    }
    .hero-cred {
      padding-bottom: 6px; display: flex; flex-direction: column; gap: 18px;
    }
    .cred-label {
      font-family: var(--font-mono); font-size: 9px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--color-faint); margin-bottom: 5px;
    }
    .cred-value {
      font-family: var(--font-heading); font-size: 13px; font-weight: 500;
      color: var(--color-text); line-height: 1.5;
    }
    .cred-value.muted { color: var(--color-muted); font-weight: 400; }
    .hero-bottom { display: grid; grid-template-columns: minmax(0, 480px) 64px 1fr; gap: 36px; align-items: end; }
    .orb-hero-anchor {
      width: 34px; height: 34px;
      align-self: center; justify-self: center;
      pointer-events: none; transform: translateY(78px);
    }
    .hero-oneliner {
      font-family: var(--font-body); font-style: italic;
      font-size: clamp(1rem, 1.4vw, 1.3rem); line-height: 1.55;
      color: var(--color-muted); max-width: 480px;
    }
    .hero-actions { display: flex; gap: 28px; justify-content: flex-end; align-items: center; }
    .hero-actions a {
      font-family: var(--font-heading); font-size: 13px; font-weight: 600;
      text-decoration: none; display: inline-block;
      transition: transform 200ms ease, color 150ms ease, border-color 150ms ease;
    }
    .cta-primary {
      color: var(--color-coral); border-bottom: 1px solid var(--color-coral); padding-bottom: 2px;
    }
    .cta-primary:hover { color: var(--color-coral-hover); border-color: var(--color-coral-hover); }
    .cta-secondary { color: var(--color-muted); }
    .cta-secondary:hover { color: var(--color-gold); }

    /* ── GitHub heatmap ──────────────────────── */
    .hero-github {
      margin-top: 28px; width: fit-content; max-width: 100%;
      padding: 14px 16px 16px; border-radius: 12px;
      border: 1px solid var(--color-border-soft);
      background: rgba(255,255,255,0.72);
    }
    .hero-github-label {
      font-family: var(--font-mono); font-size: 10.5px; color: var(--color-muted);
      letter-spacing: 0.08em; margin-bottom: 12px;
      display: flex; align-items: center; gap: 10px; white-space: nowrap;
    }
    .hero-github-label::after {
      content: ''; flex: 1; height: 1px;
      background: linear-gradient(90deg, rgba(200,61,80,0.5), transparent);
      max-width: none;
    }
    .github-heatmap {
      display: flex; gap: 3px; flex-wrap: nowrap; overflow: hidden;
      max-width: 100%; min-height: 74px;
    }
    .hm-col { display: flex; flex-direction: column; gap: 3px; }
    .hm-cell {
      width: 8px; height: 8px; border-radius: 2px;
      background: rgba(24,21,34,0.08);
      transition: transform 150ms, background 150ms, opacity 150ms;
    }
    .hm-cell[data-level="1"] { background: var(--color-coral); opacity: 0.35; }
    .hm-cell[data-level="2"] { background: var(--color-coral); opacity: 0.60; }
    .hm-cell[data-level="3"] { background: var(--color-coral); opacity: 0.85; }
    .hm-cell[data-level="4"] { background: var(--color-gold); opacity: 1; }
    .hm-cell:hover { opacity: 1 !important; transform: scale(1.3); outline: 1px solid var(--color-coral); outline-offset: 1px; z-index: 1; }
    .hm-cell[data-future] { background: rgba(24,21,34,0.035); }
    .hm-cell[data-future]:hover { opacity: 1 !important; transform: none; outline: none; }

    /* ── Sections ────────────────────────────── */
    section { padding: 100px 48px; max-width: var(--max-content); margin: 0 auto; scroll-margin-top: 82px; contain: layout style; }
    .section-label {
      font-family: var(--font-heading); font-size: 11px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-faint);
      margin-bottom: 48px; display: flex; align-items: baseline; gap: 12px;
    }

    /* ── Work ────────────────────────────────── */
    #work { border-top: 1px solid var(--color-border); position: relative; overflow: hidden; }
    .work-featured {
      margin-bottom: 24px; background: var(--color-card-strong);
      border: 1px solid var(--color-border-soft); border-radius: 16px;
      padding: 44px 48px; display: grid; grid-template-columns: 1fr 1fr;
      gap: 44px; align-items: start; position: relative; overflow: hidden;
      transition: border-color var(--transition), box-shadow var(--transition), transform 200ms ease;
    }
    .work-featured:hover {
      border-color: rgba(200,61,80,0.3);
      transform: translateY(-2px);
    }
    .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .work-card {
      background: var(--color-card);
      border: 1px solid var(--color-border-soft);
      border-radius: 16px; padding: 36px 40px; position: relative; overflow: hidden;
      transition: border-color var(--transition), box-shadow var(--transition), transform 200ms ease;
    }
    .work-atlas {
      display: grid; grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
      align-items: center; gap: 44px; margin-bottom: 20px; padding-block: 26px;
      color: inherit; text-decoration: none; cursor: pointer;
    }
    .work-atlas .card-title { margin-bottom: 0; }
    .work-atlas-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
    .work-atlas .card-body { margin-bottom: 0; max-width: 680px; }
    .work-card:hover {
      border-color: rgba(8,122,118,0.3);
      transform: translateY(-2px);
    }
    .work-card:nth-child(2):hover { border-color: rgba(101,71,180,0.3); }
    .work-card:nth-child(3):hover { border-color: rgba(137,97,0,0.3); }
    .work-card:nth-child(4):hover { border-color: rgba(200,61,80,0.3); }

    @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
      .work-featured::before,
      .work-card::before {
        content: ''; position: absolute; inset: 0; border-radius: 16px; padding: 1px;
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
        opacity: 0; transition: opacity 240ms ease;
        pointer-events: none;
      }
      .work-featured::before {
        background: linear-gradient(135deg, rgba(200,61,80,0.8), rgba(137,97,0,0.14) 40%, rgba(137,97,0,0.14) 60%, rgba(8,122,118,0.8));
      }
      .work-card::before {
        background: linear-gradient(135deg, rgba(8,122,118,0.75), rgba(8,122,118,0.1) 42%, rgba(101,71,180,0.1) 58%, rgba(101,71,180,0.75));
      }
      .work-card:nth-child(2)::before {
        background: linear-gradient(135deg, rgba(101,71,180,0.75), rgba(101,71,180,0.1) 42%, rgba(200,61,80,0.1) 58%, rgba(200,61,80,0.75));
      }
      .work-card:nth-child(3)::before {
        background: linear-gradient(135deg, rgba(137,97,0,0.75), rgba(137,97,0,0.1) 42%, rgba(200,61,80,0.1) 58%, rgba(200,61,80,0.75));
      }
      .work-card:nth-child(4)::before {
        background: linear-gradient(135deg, rgba(200,61,80,0.75), rgba(200,61,80,0.1) 42%, rgba(184,46,98,0.1) 58%, rgba(184,46,98,0.75));
      }
      .work-featured:hover, .work-card:hover { border-color: var(--color-border-soft); }
      .work-featured:hover::before, .work-card:hover::before { opacity: 1; }
    }

    .card-eyebrow { font-family: var(--font-mono); font-size: 11px; color: var(--color-faint); letter-spacing: 0.04em; margin-bottom: 10px; }
    .card-title { font-family: var(--font-heading); font-size: 20px; font-weight: 700; color: var(--color-text); letter-spacing: -0.025em; line-height: 1.15; margin-bottom: 14px; }
    .featured-title { font-size: 26px; }
    .card-body { font-family: var(--font-body); font-size: 15px; line-height: 1.7; color: var(--color-muted); margin-bottom: 20px; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
    .tag { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-muted); background: rgba(255,255,255,0.72); border: 1px solid var(--color-border-soft); border-radius: 999px; padding: 3px 10px; }
    .card-link { font-family: var(--font-heading); font-size: 12px; font-weight: 600; color: var(--color-coral); text-decoration: none; transition: color var(--transition); }
    .card-link:hover { color: var(--color-coral-hover); }
    .featured-outcome { font-family: var(--font-body); font-style: italic; font-size: 15px; line-height: 1.65; color: var(--color-muted); margin-top: 28px; }
    .card-expand-btn {
      background: none; border: none; font-family: var(--font-mono); font-size: 10px;
      color: var(--color-faint); padding: 0; letter-spacing: 0.06em;
      margin-top: 4px; display: inline-flex; align-items: center; gap: 5px; transition: color 150ms;
    }
    .card-expand-btn:hover { color: var(--color-coral); }
    .card-expand-btn .exp-arrow { display: inline-block; transition: transform 200ms ease; }
    .work-card.expanded .card-expand-btn .exp-arrow,
    .work-featured.expanded .card-expand-btn .exp-arrow { transform: rotate(45deg); }
    .card-extra { max-height: 0; overflow: hidden; transition: max-height 400ms cubic-bezier(0.16,1,0.3,1), opacity 300ms ease; opacity: 0; }
    .work-card.expanded .card-extra,
    .work-featured.expanded .card-extra { max-height: 300px; opacity: 1; }
    .card-extra-inner { padding-top: 16px; border-top: 1px solid var(--color-border); margin-top: 16px; }
    .card-extra-inner p { font-family: var(--font-body); font-size: 14px; line-height: 1.7; color: var(--color-muted); }

    /* ── Research ─────────────────────────────── */
    #research { border-top: 1px solid var(--color-border); position: relative; overflow: hidden; }
    .research-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .research-heading {
      font-family: var(--font-heading); font-size: clamp(1.6rem, 2.8vw, 2.4rem);
      font-weight: 700; letter-spacing: -0.03em; line-height: 1.1;
      color: var(--color-text);
      margin-bottom: 24px;
    }
    .research-lead { font-family: var(--font-body); font-size: 17px; line-height: 1.75; color: var(--color-muted); margin-bottom: 32px; }
    .research-stat-block {
      display: flex; flex-direction: column; gap: 20px;
      border: 1px solid var(--color-border-soft); border-radius: 16px; padding: 28px 32px;
      background: var(--color-card);
    }
    .research-stat {
      padding-bottom: 20px; border-bottom: 1px solid var(--color-border-soft);
      transition: transform 200ms ease;
    }
    .research-stat:hover { transform: translateX(6px); }
    .research-stat:last-child { border-bottom: none; padding-bottom: 0; }
    .stat-value {
      font-family: var(--font-heading); font-size: 28px; font-weight: 700;
      letter-spacing: -0.03em; line-height: 1; margin-bottom: 6px;
      color: var(--color-purple);
      transition: filter 300ms;
    }
    .stat-label { font-family: var(--font-body); font-size: 14px; color: var(--color-muted); line-height: 1.5; }
    .research-method { font-family: var(--font-body); font-size: 15px; line-height: 1.7; color: var(--color-muted); margin-bottom: 16px; }
    .research-method strong { font-weight: 500; color: var(--color-text); }

    /* ── Experience ──────────────────────────── */
    #experience { border-top: 1px solid var(--color-border); position: relative; overflow: hidden; }
    .exp-rows {
      display: flex; flex-direction: column;
      background: transparent;
    }
    .exp-row {
      display: grid; grid-template-columns: 170px minmax(0, 1fr) auto;
      column-gap: 28px; align-items: baseline;
      padding: 26px 32px; border-bottom: 1px solid var(--color-border-soft);
      transition: background 180ms ease;
      position: relative;
    }
    .exp-row:last-child { border-bottom: none; }
    .exp-row:hover { background: var(--color-card-hover); }
    .exp-when {
      font-family: var(--font-mono); font-size: 11px; color: var(--color-faint);
      letter-spacing: 0.04em; white-space: nowrap;
    }
    .exp-main { min-width: 0; }
    .exp-title {
      font-family: var(--font-heading); font-size: 16px; font-weight: 600;
      color: var(--color-text); letter-spacing: -0.015em; line-height: 1.3;
    }
    .exp-at {
      font-family: var(--font-body); font-style: italic; font-size: 14.5px;
      color: var(--color-muted);
    }
    .exp-detail {
      font-family: var(--font-body); font-size: 13.5px; line-height: 1.65;
      color: var(--color-faint); margin-top: 5px;
    }
    .exp-row:hover .exp-detail { color: var(--color-muted); }
    .exp-note { font-family: var(--font-mono); font-size: 10px; color: var(--color-faint); text-align: right; white-space: nowrap; }
    .exp-stack {
      margin-top: 28px; display: flex; flex-direction: column; gap: 9px;
      padding: 24px 32px; border: 1px solid var(--color-border-soft); border-radius: 16px;
      background: rgba(255,255,255,0.68);
    }
    .stack-row { display: grid; grid-template-columns: 170px 1fr; gap: 28px; align-items: baseline; }
    .stack-label {
      font-family: var(--font-heading); font-size: 10px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-faint);
    }
    .stack-items { font-family: var(--font-mono); font-size: 11.5px; line-height: 1.9; color: var(--color-muted); }
    .stack-items em { font-style: normal; color: var(--color-text); }

    /* ── About ───────────────────────────────── */
    #about { border-top: 1px solid var(--color-border); position: relative; overflow: hidden; }
    .about-layout { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; align-items: start; }
    .about-photo {
      min-width: 0; width: 100%; aspect-ratio: 4 / 5; position: relative;
      background: var(--color-panel);
      border: 1px solid var(--color-border-soft); border-radius: 16px;
      overflow: hidden;
    }
    .about-photo::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(200,61,80,0.1), transparent 40%, transparent 60%, rgba(8,122,118,0.08));
      pointer-events: none; z-index: 1;
    }
    .about-photo-img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .about-prose p { font-family: var(--font-body); font-size: 16px; line-height: 1.8; color: var(--color-muted); margin-bottom: 20px; }
    .about-prose p:first-of-type {
      font-size: 19px; line-height: 1.7; color: var(--color-text); font-style: italic;
    }
    .about-facts { margin-top: 36px; display: flex; flex-direction: column; gap: 12px; }
    .about-fact {
      font-family: var(--font-body); font-size: 14px; color: var(--color-muted);
      line-height: 1.5;
      transition: color 150ms;
    }
    .about-fact:hover { color: var(--color-text); }

    /* ── Now ─────────────────────────────────── */
    #now { border-top: 1px solid var(--color-border); position: relative; overflow: hidden; }
    .now-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
      border: 1px solid var(--color-border-soft); border-radius: 16px; overflow: hidden;
      background: var(--color-card);
    }
    .now-item {
      padding: 34px 38px; border-right: 1px solid var(--color-border-soft);
      position: relative; transition: background 200ms ease;
    }
    .now-item:hover { background: var(--color-coral-dim); }
    .now-item::before {
      content: ''; position: absolute; top: 20px; right: 20px;
      width: 5px; height: 5px; border-radius: 50%;
      opacity: 0; transition: opacity 200ms ease, box-shadow 200ms ease;
    }
    .now-item:nth-child(1)::before { background: var(--color-coral); box-shadow: 0 0 14px var(--color-coral-glow); }
    .now-item:nth-child(2)::before { background: var(--color-purple); box-shadow: 0 0 14px var(--color-purple-glow); }
    .now-item:nth-child(3)::before { background: var(--color-cyan); box-shadow: 0 0 14px var(--color-cyan-glow); }
    .now-item:nth-child(4)::before { background: var(--color-gold); box-shadow: 0 0 14px var(--color-gold-glow); }
    .now-item:nth-child(5)::before { background: var(--color-rose); box-shadow: 0 0 14px rgba(184,46,98,0.2); }
    .now-item:nth-child(6)::before { background: var(--color-coral); box-shadow: 0 0 14px var(--color-coral-glow); }
    .now-item:hover::before { opacity: 0.85; }
    .now-item:last-child { border-right: none; }
    .now-item:nth-child(n+4) { border-top: 1px solid var(--color-border-soft); }
    .now-item-label {
      font-family: var(--font-heading); font-size: 10px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      margin-bottom: 10px;
    }
    .now-item:nth-child(1) .now-item-label { color: var(--color-coral); }
    .now-item:nth-child(2) .now-item-label { color: var(--color-purple); }
    .now-item:nth-child(3) .now-item-label { color: var(--color-cyan); }
    .now-item:nth-child(4) .now-item-label { color: var(--color-gold); }
    .now-item:nth-child(5) .now-item-label { color: var(--color-rose); }
    .now-item:nth-child(6) .now-item-label { color: var(--color-coral); }
    .now-item-text { font-family: var(--font-body); font-size: 14.5px; line-height: 1.65; color: var(--color-muted); }
    .now-contact-icons {
      display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 14px;
    }
    .now-contact-icons a {
      width: 18px; height: 18px; display: grid; place-items: center;
      color: var(--color-muted); text-decoration: none;
      transition: color var(--transition), transform 200ms ease;
    }
    .now-contact-icons a:hover { color: var(--color-coral-hover); transform: translateY(-2px); }
    .now-contact-icons svg { width: 13px; height: 13px; display: block; }

    /* ── Status strip ────────────────────────── */
    #now-strip {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
      height: 38px; border-top: 1px solid var(--color-border);
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: flex; align-items: center; padding: 0 48px; gap: 18px;
      font-family: var(--font-mono); font-size: 11px; color: var(--color-faint);
      letter-spacing: 0.04em;
      box-shadow: 0 -4px 8px var(--color-shadow);
    }
    .strip-item { min-width: 0; display: flex; align-items: center; gap: 9px; white-space: nowrap; }
    .building-item { flex: 1 1 330px; }
    .recognition-item { flex: 1 1 300px; }
    .watching-item { flex: 0 1 190px; }
    .strip-label { color: var(--color-faint); letter-spacing: 0.04em; }
    .strip-value { min-width: 0; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; }
    .strip-value.accent { color: var(--color-coral); }
    .strip-ticker {
      display: block; position: relative; min-width: 0; max-width: 100%;
      overflow: hidden; text-overflow: clip;
    }
    .strip-ticker-track {
      display: inline-flex; gap: 36px; min-width: max-content;
      transform: translateX(0); will-change: transform;
      animation: strip-ticker 7.5s linear infinite;
    }
    @keyframes strip-ticker {
      from { transform: translateX(0); }
      to { transform: translateX(calc(-50% - 18px)); }
    }
    .strip-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--color-coral);
      animation: pulse-dot 2.5s ease-in-out infinite;
      box-shadow: 0 0 14px var(--color-coral-glow);
      flex: 0 0 auto;
    }
    @keyframes pulse-dot { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
    .strip-sep { color: var(--color-border); font-size: 14px; flex: 0 0 auto; }
    .strip-social-icons { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
    .strip-social-icons a {
      width: 16px; height: 16px; display: grid; place-items: center;
      color: var(--color-faint); text-decoration: none;
      transition: color var(--transition), transform 200ms ease;
    }
    .strip-social-icons a:hover { color: var(--color-coral-hover); transform: translateY(-2px); }
    .strip-social-icons svg { width: 12px; height: 12px; display: block; }
    .strip-clock { margin-left: auto; color: var(--color-faint); min-width: 66px; text-align: right; }

    /* ── Custom cursor ───────────────────────── */
    .cursor-dot {
      position: fixed; width: 5px; height: 5px;
      background: var(--color-coral); border-radius: 50%;
      pointer-events: none; z-index: 10002;
      transform: translate(-50%,-50%);
      transition: width 220ms ease, height 220ms ease, opacity 200ms,
                  border-radius 220ms ease, background 200ms, transform 200ms,
                  box-shadow 200ms ease;
      opacity: 0; box-shadow: 0 0 12px var(--color-coral-glow);
    }
    .cursor-ring {
      position: fixed; width: 28px; height: 28px;
      border: 1.5px solid rgba(200,61,80,0.55);
      border-radius: 50%;
      pointer-events: none; z-index: 10001;
      transform: translate(-50%,-50%);
      transition: width 280ms cubic-bezier(0.16,1,0.3,1),
                  height 280ms cubic-bezier(0.16,1,0.3,1),
                  border-radius 280ms cubic-bezier(0.16,1,0.3,1),
                  border-color 200ms, background 200ms, opacity 300ms,
                  box-shadow 220ms ease, transform 220ms ease;
      opacity: 0; background: transparent;
      box-shadow: 0 0 20px rgba(200,61,80,0.08);
    }
    body:hover .cursor-dot, body:hover .cursor-ring { opacity: 1; }

    /* Lens: hero name */
    .cursor-ring.cur-lens {
      width: 76px; height: 76px;
      border: 1px solid rgba(137,97,0,0.45);
      backdrop-filter: blur(3px) brightness(0.98) saturate(1.2);
      -webkit-backdrop-filter: blur(3px) brightness(0.98) saturate(1.2);
      background: radial-gradient(circle at 35% 32%, rgba(255,255,255,0.5), rgba(200,61,80,0.05) 45%, rgba(137,97,0,0.03));
      box-shadow: inset 0 1px 8px rgba(255,255,255,0.52), 0 0 24px var(--color-coral-glow);
    }
    .cursor-ring.cur-lens::after {
      content: ''; position: absolute; opacity: 1; inset: 13px;
      border: 1px solid rgba(24,21,34,0.1); border-radius: 50%;
      pointer-events: none;
    }
    .cursor-dot.cur-lens { width: 3px; height: 3px; opacity: 0.35; }

    /* Nav orb */
    .cursor-ring.cur-nav {
      width: 34px; height: 34px; border-radius: 50%;
      border-color: rgba(200,61,80,0.45);
      background: conic-gradient(from 40deg, rgba(200,61,80,0), rgba(200,61,80,0.4), rgba(137,97,0,0));
      box-shadow: 0 0 30px var(--color-coral-glow);
    }
    .cursor-ring.cur-nav::before {
      content: ''; position: absolute; opacity: 1;
      width: 5px; height: 5px; right: 1px; top: 5px;
      border-radius: 50%; background: var(--color-coral);
      box-shadow: 0 0 14px var(--color-coral-glow);
      pointer-events: none;
    }
    .cursor-ring.cur-nav::after {
      content: ''; position: absolute; opacity: 1;
      left: 50%; top: 50%; width: 12px; height: 1px;
      background: var(--color-coral);
      transform: translate(-1px,-50%) rotate(-35deg);
      transform-origin: left center;
      pointer-events: none;
    }
    .cursor-dot.cur-nav { width: 3px; height: 3px; opacity: 0.5; }

    /* Grid: heatmap */
    .cursor-ring.cur-grid {
      width: 34px; height: 18px; border-radius: 4px;
      border-color: rgba(200,61,80,0.5);
      background:
        linear-gradient(90deg, transparent 7px, rgba(200,61,80,0.22) 8px, transparent 9px),
        linear-gradient(0deg, transparent 7px, rgba(200,61,80,0.22) 8px, transparent 9px);
      background-size: 9px 9px;
      transform: translate(-50%,-50%) skewX(-10deg);
    }
    .cursor-dot.cur-grid {
      width: 4px; height: 4px; border-radius: 1px;
      animation: cursor-zig 620ms steps(2, end) infinite;
    }
    @keyframes cursor-zig {
      0%, 100% { transform: translate(-50%,-50%) translate(-5px,-3px); }
      50% { transform: translate(-50%,-50%) translate(5px,3px); }
    }

    /* Expand: cards */
    .cursor-ring.cur-expand {
      width: 20px; height: 20px; border-radius: 2px;
      border-color: rgba(8,122,118,0.9);
      box-shadow: 0 0 20px var(--color-cyan-glow);
    }
    .cursor-dot.cur-expand {
      width: 2px; height: 18px; border-radius: 1px;
      background: var(--color-cyan); box-shadow: none;
    }
    .cursor-dot.cur-expand::before {
      content: ''; position: absolute; pointer-events: none; opacity: 1;
      left: -8px; top: 8px; width: 18px; height: 2px;
      background: var(--color-cyan); border-radius: 1px;
    }
    .cursor-ring.cur-expand::before,
    .cursor-ring.cur-expand::after {
      content: ''; position: absolute; pointer-events: none; opacity: 1;
      background: var(--color-cyan);
    }
    .cursor-ring.cur-expand::before { left: 50%; top: -5px; width: 1px; height: 4px; box-shadow: 0 25px 0 var(--color-cyan); }
    .cursor-ring.cur-expand::after { top: 50%; left: -5px; width: 4px; height: 1px; box-shadow: 25px 0 0 var(--color-cyan); }

    .cursor-ring.cur-close {
      width: 30px; height: 30px; border-radius: 4px;
      border-color: rgba(200,61,80,0.85);
      transform: translate(-50%,-50%) rotate(45deg);
    }
    .cursor-dot.cur-close {
      width: 2px; height: 18px; border-radius: 1px; background: var(--color-coral);
      transform: translate(-50%,-50%) rotate(45deg);
    }
    .cursor-dot.cur-close::before {
      content: ''; position: absolute; pointer-events: none; opacity: 1;
      left: -8px; top: 8px; width: 18px; height: 2px;
      background: var(--color-coral); border-radius: 1px;
    }

    /* Stats square */
    .cursor-ring.cur-square {
      width: 10px; height: 10px; border-radius: 2px;
      border-color: var(--color-purple);
      background: rgba(101,71,180,0.14);
      box-shadow: 0 0 20px var(--color-purple-glow);
    }
    .cursor-dot.cur-square { width: 4px; height: 4px; border-radius: 1px; }

    /* CTA pulse */
    .cursor-ring.cur-cta {
      width: 64px; height: 64px;
      border-color: rgba(200,61,80,0.55);
      animation: cta-ring-pulse 1.2s ease-in-out infinite;
      background: rgba(200,61,80,0.03);
    }
    .cursor-dot.cur-cta { width: 6px; height: 6px; }
    @keyframes cta-ring-pulse {
      0%, 100% { box-shadow: 0 0 0 0 var(--color-coral-glow); }
      50% { box-shadow: 0 0 0 10px rgba(200,61,80,0); }
    }

    /* Arrow: links */
    .cursor-ring.cur-arrow {
      width: 22px; height: 22px;
      border-radius: 50% 50% 50% 3px;
      transform: translate(-50%,-50%) rotate(-45deg);
      border-color: var(--color-gold);
    }
    .cursor-ring.cur-arrow::after {
      content: ''; position: absolute; pointer-events: none; opacity: 1;
      right: 2px; top: 2px;
      width: 7px; height: 7px; border-top: 1px solid var(--color-gold); border-right: 1px solid var(--color-gold);
    }
    .cursor-dot.cur-arrow { opacity: 0; }

    /* Live blink: now grid */
    .cursor-ring.cur-live {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--color-coral); border: none;
      animation: live-blink 1s step-end infinite;
      box-shadow: 0 0 24px var(--color-coral-glow);
    }
    .cursor-dot.cur-live { opacity: 0; }
    @keyframes live-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }

    .cursor-ring.cur-orb {
      width: 36px; height: 36px;
      border-color: rgba(137,97,0,0.6);
      background: rgba(200,61,80,0.04);
      box-shadow: inset 0 1px 10px rgba(255,255,255,0.1), 0 0 30px var(--color-coral-glow);
    }
    .cursor-dot.cur-orb {
      width: 8px; height: 8px;
      background: rgba(224,164,46,0.95);
      box-shadow: 0 0 14px var(--color-gold-glow);
    }

    /* ── Scroll reveal ───────────────────────── */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }

    /* ── Responsive ──────────────────────────── */
    @media (min-width: 1280px) {
      :root { --max-content: 1180px; }
      #hero { padding-inline: clamp(48px, 6vw, 96px); }
      section { padding-inline: clamp(48px, 6vw, 96px); }
