      width: 64px; height: 64px;
      border-color: rgba(79,154,141,0.5);
      animation: cta-ring-pulse 1.2s ease-in-out infinite;
      background: rgba(79,154,141,0.025);
    }
    .cursor-dot.cur-cta { width: 6px; height: 6px; }
    @keyframes cta-ring-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(79,154,141,0.15); }
      50% { box-shadow: 0 0 0 10px rgba(79,154,141,0); }
    }

    /* Footer/external links: outbound arrow (rotated corner) */
    .cursor-ring.cur-arrow {
      width: 22px; height: 22px;
      border-radius: 50% 50% 50% 3px;
      transform: translate(-50%,-50%) rotate(-45deg);
      border-color: var(--color-accent);
    }
    .cursor-ring.cur-arrow::after {
      opacity: 1; right: 2px; top: 2px;
      width: 7px; height: 7px; border-top: 1px solid var(--color-accent); border-right: 1px solid var(--color-accent);
    }
    .cursor-dot.cur-arrow { opacity: 0; }

    /* Now grid: live dot blink */
    .cursor-ring.cur-live {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--color-accent);
      border: none;
      animation: live-blink 1s step-end infinite;
      box-shadow: 0 0 22px rgba(79,154,141,0.45);
    }
