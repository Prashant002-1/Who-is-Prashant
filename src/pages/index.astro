    </div>

    <p class="closing reveal">
      Every system I've built started with watching someone struggle with the one it replaced.
    </p>
  </section>

</Base>

<script is:inline>
  // Background transitions per section
  document.addEventListener('astro:page-load', () => {
    const bgMap = {
      hero: 'home',
      experience: 'work',
      projects: 'research',
      about: 'about',
    };

    const sceneImage = document.querySelector('.scene-image');
    const sceneGradient = document.querySelector('.scene-gradient');
    if (!sceneImage || !sceneGradient) return;

    const gradients = {
      home: 'radial-gradient(ellipse at 60% 30%, #112b24 0%, #0a1a16 40%, #09090f 100%)',
      work: 'radial-gradient(ellipse at 30% 60%, #0f1f17 0%, #0a1410 40%, #09090f 100%)',
      research: 'radial-gradient(ellipse at 50% 20%, #0a1a1e 0%, #06101a 45%, #09090f 100%)',
      about: 'radial-gradient(ellipse at 50% 60%, #0d1a14 0%, #080f0d 45%, #09090f 100%)',
    };

    let currentBg = 'home';

    function setBg(key) {
      if (key === currentBg) return;
      currentBg = key;
      sceneImage.style.transition = 'opacity 0.8s ease';
      sceneImage.style.opacity = '0';
      setTimeout(() => {
        sceneImage.style.backgroundImage = `url('/backgrounds/${key}.jpg'), ${gradients[key]}`;
        sceneGradient.style.background = gradients[key];
        sceneImage.style.opacity = '0.3';
      }, 400);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const key = bgMap[entry.target.id];
          if (key) setBg(key);
        }
      });
    }, { rootMargin: '-35% 0px -35% 0px' });

    Object.keys(bgMap).forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 4rem;
  }

  h1 {
    font-size: clamp(1.7rem, 4.2vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    max-width: 520px;
    line-height: 1.15;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5);
  }

  .context {
    font-size: 0.88rem;
    color: var(--color-muted);
    max-width: 400px;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .ctas { display: flex; gap: 0.75rem; align-items: center; }

  .btn-primary {
    display: inline-block; font-size: 0.8rem; font-weight: 600;
    background: var(--color-accent); color: #09090f;
    padding: 0.6rem 1.5rem; border-radius: 8px; text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: #09090f; transform: translateY(-1px); }

  .btn-ghost {
    display: inline-block; font-size: 0.8rem; font-weight: 500;
    color: var(--color-muted); padding: 0.6rem 1rem; text-decoration: none;
    transition: color 150ms ease;
  }
  .btn-ghost:hover { color: var(--color-text); }

  /* ── Sections ── */
  .section {
    padding: 5rem 0 4rem;
    scroll-margin-top: 60px;
  }

  .section-title {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 2.5rem;
  }

  /* ── Experience Timeline ── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-left: 1px solid var(--color-border);
    padding-left: 2rem;
    margin-left: 0.5rem;
  }

  .timeline-entry { position: relative; }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: -2.35rem;
    top: 0.35rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-glow);
  }

  .timeline-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-faint);
  }

  .timeline-place {
    font-size: 0.72rem;
    color: var(--color-faint);
  }

  .timeline-body h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .timeline-body p {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* ── Featured Research ── */
  .featured {
    padding: 2rem 2rem 1.75rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 14px 14px 0;
  }

  .featured-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.75rem;
  }

  .featured h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .featured-advisor {
    font-size: 0.78rem;
    color: var(--color-faint);
    margin-bottom: 1rem;
  }

  .featured-prose {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .featured-prose p {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  .featured-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  /* ── Project Grid ── */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 639px) {
    .project-grid { grid-template-columns: 1fr; }
  }

  .project-card {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
  }

  .project-card h3 {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
    transition: color 150ms ease;
  }

  .project-card:hover h3 { color: var(--color-accent); }

  .project-stack {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-faint);
    margin-bottom: 0.6rem;
  }

  .project-card > p:last-child {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Press ── */
  .press-links {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
  }

  .press-label { color: var(--color-faint); }
  .press-links a { color: var(--color-accent); }

  /* ── About ── */
  .about-content {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .about-content { grid-template-columns: 1fr; gap: 2rem; }
  }

  .about-prose {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .about-prose p {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 0;
  }

  .about-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-detail h4 {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin-bottom: 0.4rem;
  }

  .about-detail p,
  .about-detail li {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .about-detail ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-detail li { margin-bottom: 0.2rem; }

  .about-detail a {
    color: var(--color-accent);
    font-size: 0.82rem;
  }

  .closing {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
