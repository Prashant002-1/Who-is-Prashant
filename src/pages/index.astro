---
import Base from "../layouts/Base.astro";
---

<Base title="Prashant Shah" bg="home">
  <section class="hero reveal">
    <h1 transition:name="page-title">Prashant Shah</h1>
    <p class="oneliner">
      I build software that works for the people using it.
    </p>
    <ul class="signals">
      <li>Built production systems at Trimble and Novartis</li>
      <li>Research: emotion-aware retrieval with knowledge graphs</li>
      <li>Graduating May 2026 — open to full-time roles</li>
    </ul>
    <a href="/resume.pdf" class="resume-link">Resume &rarr;</a>
  </section>

  <section class="panel glass reveal" style="animation-delay: 0.2s">
    <article>
      <h2><a href="/projects">Canvas Agent</a></h2>
      <p>A tool-calling AI agent over LMS data — 9 typed tools, parameterized SQL,
      persistent memory via pgvector. Won HackRamapo.</p>
    </article>
    <article>
      <h2><a href="/work">Trimble</a></h2>
      <p>Production configuration management platform in C#/.NET and Azure
      for a distributed broker architecture used across engineering teams.</p>
    </article>
    <article>
      <h2><a href="/projects">The Research</a></h2>
      <p>What happens when user intent contradicts content semantics?
      Resolving affective conflict in retrieval with knowledge graphs.</p>
    </article>

    <p class="currently">
      Finishing up research and looking for full-time roles starting Summer 2026.
      <a href="/now">See what I'm up to.</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.1rem;
    line-height: 1.08;
    text-shadow:
      0 0 80px rgba(167, 139, 250, 0.25),
      0 2px 24px rgba(0, 0, 0, 0.7);
  }

  .oneliner {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 400px;
    margin-bottom: 1.75rem;
    line-height: 1.55;
  }

  .signals {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .signals li {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.015em;
  }

  .resume-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 150ms ease;
  }

  .resume-link:hover {
    color: var(--color-accent-hover);
    text-decoration: none;
  }

  .panel {
    padding: 0 1.75rem;
  }

  article {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  article:first-child {
    padding-top: 1.4rem;
  }

  article:last-of-type {
    border-bottom: none;
  }

  article h2 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }

  article h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms ease;
  }

  article h2 a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  article p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.65;
  }

  .currently {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-muted);
    padding: 1.25rem 0 1.4rem;
    margin: 0;
    line-height: 1.6;
  }

  .currently a {
    color: var(--color-accent);
  }
</style>
