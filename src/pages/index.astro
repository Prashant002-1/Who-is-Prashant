      .hero-bottom { grid-template-columns: 1fr; gap: 20px; }
      .hero-actions { justify-content: flex-start; }
      section { padding: 64px 24px; }
      .work-grid, .research-layout, .about-layout { grid-template-columns: 1fr; gap: 32px; }
      .work-featured { grid-template-columns: 1fr; gap: 24px; }
