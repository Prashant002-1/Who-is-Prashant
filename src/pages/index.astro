---
import Base from "../layouts/Base.astro";
---

<Base
  title="Prashant Shah"
  description="Software engineer and researcher. Building systems that respect how people actually use them."
  bg="home"
>
  <nav class="site-nav">
    <a href="/" class="logo" transition:name="brand">PS</a>
    <div class="nav-links">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="#now" class="now-pill">Now</a>
    </div>
  </nav>

  <main class="page" transition:name="main">
    <section class="hero-stage">
      <div class="hero-kicker">
        <span class="hero-line" aria-hidden="true"></span>
        <span>Portfolio / 2026</span>
      </div>
      <h1 class="hero-title display-shadow" transition:name="title">Prashant Shah</h1>
      <p class="hero-tagline display-shadow">22 &middot; Software engineer &middot; Researcher</p>
      <p class="hero-status display-shadow">
        <span class="status-dot"></span>
        Building my capstone, finishing research, looking for full-time roles
      </p>
      <div class="hero-actions">
        <a href="mailto:shahp0021@gmail.com" class="btn">Get in touch</a>
        <a href="/resume.pdf" class="btn btn-ghost">Resume</a>
      </div>
    </section>

    <div class="stream">
      <section class="glass panel rise" style="animation-delay: 0ms">
        <h2>About</h2>
        <div class="about-text">
          <p>
            I build software that closes the gap between what systems know and what people need. Every
            system I have built started with watching someone struggle with the one it replaced.
          </p>
          <p>
            Three languages before I was ten (Bengali, English, Hindi). CS and Data Science at Ramapo
            College, 3.84 GPA, graduating May 2026. Co-founded the CS club and convinced Bjarne
            Stroustrup to come speak.
          </p>
        </div>
        <div class="widget glass glass-interactive">
          <div class="widget-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M7 5V3M17 5V3M9 12h6M9 16h4" stroke-linecap="round" />
            </svg>
          </div>
          <div class="widget-body">
            <span class="widget-label">Watching</span>
            <a href="https://letterboxd.com/_Prashant_/" target="_blank" rel="noopener noreferrer"
              >Letterboxd</a
            >
          </div>
        </div>
      </section>

      <section class="glass panel rise" style="animation-delay: 70ms">
        <h2>Connect</h2>
        <div class="connect-row">
          <a
            href="https://github.com/Prashant002-1"
            target="_blank"
            rel="noopener noreferrer"
            class="connect-pill glass glass-interactive"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              /></svg
            >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/prashant210/"
            target="_blank"
            rel="noopener noreferrer"
            class="connect-pill glass glass-interactive"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              /></svg
            >
            LinkedIn
          </a>
          <a href="mailto:shahp0021@gmail.com" class="connect-pill glass glass-interactive">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
              ></path></svg
            >
            Email
          </a>
          <a
            href="https://letterboxd.com/_Prashant_/"
            target="_blank"
            rel="noopener noreferrer"
            class="connect-pill glass glass-interactive"
          >
            Letterboxd
          </a>
        </div>
      </section>

      <section id="now" class="glass panel rise now-panel" style="animation-delay: 100ms">
        <header class="now-head">
          <h2>Now</h2>
          <p class="now-updated">Last updated April 2026</p>
        </header>
        <div class="now-stack">
          <section>
            <h3>Building</h3>
            <p>
              Finishing my capstone on collision risk prediction in autonomous driving simulations, and
              wrapping up the pantry inventory system for the Center for Food Action.
            </p>
          </section>
          <section>
            <h3>Researching</h3>
            <p>
              Resolving intent-content conflict in retrieval. What happens when a user's emotional intent
              contradicts the semantics of what they are searching for.
            </p>
          </section>
          <section>
            <h3>Learning</h3>
            <p>
              Graph Transformers and how structured knowledge can make retrieval systems smarter than
              embeddings alone.
            </p>
          </section>
          <section>
            <h3>Watching</h3>
            <p>
              Tracking on <a href="https://letterboxd.com/_Prashant_/" target="_blank" rel="noopener noreferrer"
                >Letterboxd</a
              >.
            </p>
          </section>
          <section>
            <h3>Looking for</h3>
            <p>Full-time software engineering, AI/ML, or data roles starting Summer 2026.</p>
          </section>
        </div>
      </section>

      <section id="work" class="glass panel rise" style="animation-delay: 140ms">
        <h2>Experience</h2>
        <div class="exp-list">
          <div class="exp-item">
            <div class="exp-head">
              <h3>Trimble</h3>
              <span class="exp-type">Internship &middot; Summer 2025</span>
            </div>
            <p>
              Built a configuration management platform in C#/.NET and Azure. Single source of truth
              for a distributed broker architecture. Auth proxy through Azure Workload Identity
              Federation.
            </p>
            <div class="tags">
              <span>C#</span><span>.NET</span><span>Azure</span><span>Blazor</span><span>REST APIs</span>
            </div>
          </div>

          <div class="exp-item">
            <div class="exp-head">
              <h3>Novartis</h3>
              <span class="exp-type">Internship &middot; Summer 2024</span>
            </div>
            <p>
              Replaced a manual project proposal workflow. React/TypeScript app with Azure Functions.
              What took two days now took hours.
            </p>
            <div class="tags">
              <span>React</span><span>TypeScript</span><span>Azure Functions</span><span>PostgreSQL</span>
            </div>
          </div>

          <div class="exp-item">
            <div class="exp-head">
              <h3>Data Analyst &middot; Ramapo College</h3>
              <span class="exp-type">2023 &ndash; 2024</span>
            </div>
            <p>
              Python pipelines for 6,000+ student records. Automated data quality checks and reporting
              dashboards.
            </p>
            <div class="tags">
              <span>Python</span><span>SQL</span><span>Pandas</span>
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="glass panel rise" style="animation-delay: 210ms">
        <h2>Projects and research</h2>

        <div class="research-block">
          <span class="research-tag">Ongoing research</span>
          <h3>Resolving intent-content conflict in retrieval</h3>
          <p class="research-advisor">With Dr. Ali Al-Juboori, Ramapo College</p>
          <p>
            What happens when someone wants a happy movie about war? Retrieval systems break. I am
            building a framework that makes emotions first-class entities in a knowledge graph so the
            system can hold both ideas at once. 1,600 queries tested. The graph structure is doing real
            work.
          </p>
          <a
            href="https://github.com/Prashant002-1/knowledge-graph-retrieval-with-affective-grounding"
            target="_blank"
            rel="noopener noreferrer">Repository</a
          >
        </div>

        <div class="proj-grid">
          <div class="proj-card glass glass-interactive">
            <h3>Canvas Agent</h3>
            <p>AI agent for my LMS. Nine tools, persistent memory, generative UI. Won HackRamapo.</p>
            <div class="tags">
              <span>TypeScript</span><span>Next.js</span><span>pgvector</span>
            </div>
          </div>
          <div class="proj-card glass glass-interactive">
            <h3>Center for Food Action</h3>
            <p>
              Barcode-scanning inventory for pantry volunteers. One-handed iPad interface. 40,000 people
              served.
            </p>
            <div class="tags">
              <span>Flask</span><span>PostgreSQL</span>
            </div>
          </div>
          <div class="proj-card glass glass-interactive">
            <h3>EmotionFlix</h3>
            <p>Emotion-based movie recs. On-device face scanning, 69 tests, no data leaves the browser.</p>
            <div class="tags">
              <span>React</span><span>Node.js</span>
            </div>
          </div>
          <div class="proj-card glass glass-interactive">
            <h3>ADV collision risk</h3>
            <p>Capstone. Predicting which autonomous driving scenarios cause collisions. 33,530 scenarios.</p>
            <div class="tags">
              <span>XGBoost</span><span>scikit-learn</span>
            </div>
          </div>
        </div>

        <div class="press-row">
          <span>Press:</span>
          <a
            href="https://newjersey.news12.com/ramapo-college-students-use-technology-to-streamline-food-pantry-operations"
            target="_blank"
            rel="noopener noreferrer">News 12 NJ</a
          >
          <a
            href="https://www.ramapo.edu/news/slide/real-world-impact-ramapo-developed-tech-to-revolutionize-food-banks/"
            target="_blank"
            rel="noopener noreferrer">Ramapo News</a
          >
        </div>
      </section>

      <section id="about" class="glass panel rise" style="animation-delay: 280ms">
        <h2>More about me</h2>
        <div class="about-grid">
          <div class="about-col">
            <p>
              I came to Ramapo for computer science and stayed because the scale let me do things.
              Managed 17 RAs and a community of 200+. Led the math club. Competed in ICPC at the New York
              regional.
            </p>
            <p>
              I want to be the kind of engineer who understands the system end to end: the data, the
              infrastructure, the interface, and the person on the other side of it.
            </p>
          </div>
          <div class="about-side-col">
            <div class="side-block">
              <h4>Education</h4>
              <p>BS CS and Data Science<br />Minor in Mathematics<br />Ramapo College, 3.84 GPA</p>
            </div>
            <div class="side-block">
              <h4>Awards</h4>
              <p>Canstruction 1st place<br />Student Employee of the Year<br />Presidential Scholarship (4 yrs)</p>
            </div>
          </div>
        </div>
        <div class="art-strip">
          <img src="/backgrounds/home.jpg" alt="" loading="lazy" />
          <img src="/backgrounds/now.jpg" alt="" loading="lazy" />
          <img src="/backgrounds/about.jpg" alt="" loading="lazy" />
        </div>
      </section>

      <section class="quote-section rise" style="animation-delay: 320ms">
        <blockquote>
          Every system I have built started with watching someone struggle with the one it replaced.
        </blockquote>
      </section>

      <footer class="footer">
        <span>&copy; 2026 Prashant Shah</span>
        <span class="footer-note">Built with care, not templates.</span>
      </footer>
    </div>
  </main>
</Base>

<style>
  .page {
    padding-bottom: 3rem;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    gap: 1.35rem;
    align-items: center;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .now-pill {
    font-size: 0.72rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent) !important;
    border: 1px solid var(--color-border-bright);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(157, 139, 201, 0.08);
  }

  .now-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-hover) !important;
  }

  .now-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.25rem;
  }

  .now-head h2 {
    margin: 0;
  }

  .now-updated {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin: 0;
  }

  .now-stack section {
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .now-stack section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .now-stack h3 {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin: 0 0 0.4rem;
  }

  .now-stack p {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 0;
  }

  .hero-stage {
    min-height: min(88vh, 960px);
    padding: 5.5rem 1.25rem 3.5rem;
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(242, 238, 248, 0.55);
  }

  .hero-line {
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 168, 124, 0.85), transparent);
    opacity: 0.9;
  }

  .hero-title {
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    margin: 0;
    line-height: 1.02;
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: rgba(242, 238, 248, 0.72);
    margin: 0;
  }

  .hero-status {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: rgba(242, 238, 248, 0.55);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 36rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8fb89a;
    box-shadow: 0 0 12px rgba(143, 184, 154, 0.55);
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .btn {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, rgba(157, 139, 201, 0.95), rgba(120, 100, 170, 0.95));
    color: #0b090f;
    padding: 0.55rem 1.35rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }

  .btn:hover {
    color: #0b090f;
    filter: brightness(1.06);
  }

  .btn-ghost {
    background: rgba(8, 7, 12, 0.35);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }

  .btn-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-border-bright);
    filter: none;
  }

  .stream {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel {
    padding: 1.75rem 1.85rem;
  }

  .panel h2 {
    font-size: 1.05rem;
    margin: 0 0 1.1rem;
    color: var(--color-text);
  }

  .rise {
    opacity: 0;
    animation: rise-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      opacity: 1;
      animation: none;
    }
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .about-text p {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: 0;
  }

  .widget {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-radius: 14px;
    padding: 0.85rem 1.05rem;
  }

  .widget-icon {
    color: var(--color-accent);
    display: flex;
  }

  .widget-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-faint);
    display: block;
    margin-bottom: 0.15rem;
  }

  .widget-body a {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .connect-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .connect-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--color-muted);
    border-radius: 12px;
    padding: 0.5rem 0.95rem;
  }

  .connect-pill svg {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .connect-pill:hover {
    color: var(--color-text);
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .exp-item {
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .exp-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .exp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .exp-head h3 {
    font-size: 0.98rem;
    margin: 0;
  }

  .exp-type {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    color: var(--color-faint);
    white-space: nowrap;
  }

  .exp-item > p {
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.58;
    margin: 0 0 0.65rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags span {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .research-block {
    background: rgba(157, 139, 201, 0.07);
    border: 1px solid rgba(157, 139, 201, 0.22);
    border-left: 3px solid rgba(201, 168, 124, 0.85);
    border-radius: 0 14px 14px 0;
    padding: 1.25rem 1.45rem;
    margin-bottom: 1.35rem;
  }

  .research-tag {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.45rem;
  }

  .research-block h3 {
    font-size: 1.05rem;
    margin: 0 0 0.2rem;
  }

  .research-advisor {
    font-size: 0.78rem;
    color: var(--color-faint);
    margin: 0 0 0.65rem;
  }

  .research-block > p {
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.58;
    margin: 0 0 0.55rem;
  }

  .research-block a {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 560px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }

  .proj-card {
    padding: 1.05rem 1.2rem;
    border-radius: 14px;
  }

