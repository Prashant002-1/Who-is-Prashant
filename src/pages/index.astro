<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  // ── Smooth scroll for nav anchors ──
  document.querySelectorAll('a[data-nav]').forEach(link => {
    link.addEventListener('click', e => {
      const href = link.getAttribute('href');
      if (href?.startsWith('#')) {
        e.preventDefault();
        document.querySelector(href)?.scrollIntoView({ behavior: 'smooth' });
        history.pushState(null, '', href);
        document.querySelector('[data-mobile-nav]')?.classList.add('hidden');
      }
    });
  });

  // ── Mobile menu ──
  const burger = document.querySelector('[data-burger]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  burger?.addEventListener('click', () => mobileNav?.classList.toggle('hidden'));
  mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileNav?.classList.add('hidden')));

  // ── Active section highlight ──
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('a[data-nav]');
  const sectionObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(l => l.classList.remove('active'));
        navLinks.forEach(l => {
          if (l.getAttribute('href') === '#' + entry.target.id) l.classList.add('active');
        });
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => sectionObs.observe(s));

  // ── Parallax backgrounds ──
  const layers = document.querySelectorAll('[data-parallax]');
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        layers.forEach(layer => {
          const speed = parseFloat(layer.dataset.parallax);
          layer.style.transform = `translate3d(0, ${scrollY * speed}px, 0)`;
        });
        ticking = false;
      });
      ticking = true;
    }
  });

  // ── Fade-up on scroll ──
  const fadeEls = document.querySelectorAll('.fade-up');
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        fadeObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  fadeEls.forEach(el => fadeObs.observe(el));

  // ── Nav bg on scroll ──
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 60);
  });
});
</script>

<style>
  /* ── Animations ── */
  .fade-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Nav ── */
  #nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    transition: background 300ms ease, border-color 300ms ease;
    border-bottom: 1px solid transparent;
  }
  #nav.scrolled {
    background: rgba(6, 6, 8, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: var(--color-border);
  }
  .nav-inner {
    max-width: 960px; margin: 0 auto; padding: 0 1.5rem;
    height: 56px; display: flex; align-items: center; justify-content: space-between;
  }
  .wordmark {
    font-weight: 700; font-size: 1rem; color: var(--color-text);
    text-decoration: none; letter-spacing: -0.02em;
  }
  .wordmark:hover { color: var(--color-accent); }
  .nav-links {
    display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0;
  }
  .nav-links a {
    font-size: 0.82rem; font-weight: 500; color: var(--color-muted);
    text-decoration: none; transition: color 150ms ease;
  }
  .nav-links a:hover { color: var(--color-text); }
  .nav-links a.active { color: var(--color-accent); }
  .now-link { opacity: 0.7; }
  .burger {
    display: none; background: none; border: none; color: var(--color-muted);
    cursor: pointer; padding: 4px;
  }
  .mobile-nav {
    padding: 1rem 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;
    background: rgba(6, 6, 8, 0.95); border-bottom: 1px solid var(--color-border);
  }
  .mobile-nav.hidden { display: none; }
  .mobile-nav a { font-size: 0.95rem; color: var(--color-muted); text-decoration: none; }
  .mobile-nav a:hover { color: var(--color-text); }

  @media (max-width: 639px) {
    .nav-links { display: none; }
    .burger { display: block; }
  }

  /* ── Parallax Backgrounds ── */
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 120vh;
    background-size: cover; background-position: center;
    pointer-events: none; will-change: transform;
  }
  .bg-hero {
    background-image: url('/bg/hero-bg.png');
    opacity: 0.55;
    z-index: -3;
  }
  .bg-mid {
    background-image: url('/bg/mid-bg.png');
    opacity: 0.35;
    z-index: -2;
  }
  .bg-lower {
    background-image: url('/bg/lower-bg.png');
    opacity: 0.30;
    z-index: -1;
  }

  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    justify-content: center; align-items: flex-start;
    max-width: 960px; margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 600; max-width: 560px;
    line-height: 1.12; margin-bottom: 1.25rem;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.6);
  }
  .hero-sub {
    font-size: 0.9rem; color: var(--color-muted);
    max-width: 400px; margin-bottom: 2rem; line-height: 1.5;
  }
  .hero-ctas { display: flex; gap: 0.75rem; align-items: center; }

  .btn-primary {
    font-size: 0.8rem; font-weight: 600;
    background: var(--color-accent); color: #060608;
    padding: 0.6rem 1.5rem; border-radius: 8px;
    text-decoration: none;
    transition: background 150ms, transform 150ms;
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: #060608; transform: translateY(-1px); }

  .btn-ghost {
    font-size: 0.8rem; font-weight: 500;
    color: var(--color-muted); padding: 0.6rem 1rem;
    text-decoration: none;
  }
  .btn-ghost:hover { color: var(--color-text); }

  .scroll-hint {
    position: absolute; bottom: 2.5rem; left: 50%;
    transform: translateX(-50%); color: var(--color-faint);
  }
  .scroll-dot { animation: scrollBounce 2s ease-in-out infinite; }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(4px); opacity: 0.3; }
  }

  /* ── Sections ── */
  .section {
    padding: 6rem 0;
    scroll-margin-top: 60px;
  }
  .section-inner {
    max-width: 960px; margin: 0 auto; padding: 0 1.5rem;
  }
  .section-label {
    font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 3rem;
  }

  /* ── Timeline ── */
  .timeline {
    display: flex; flex-direction: column; gap: 2.5rem;
    padding-left: 2rem; border-left: 1px solid var(--color-border);
    margin-left: 0.5rem;
  }
  .tl-item { position: relative; }
  .tl-dot {
    position: absolute; left: -2.35rem; top: 0.2rem;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-glow), 0 0 4px var(--color-accent);
  }
  .tl-meta {
    font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--color-faint); margin-bottom: 0.3rem;
  }
  .tl-item h3 {
    font-size: 0.95rem; color: var(--color-text); margin-bottom: 0.4rem;
  }
  .tl-item p {
    font-size: 0.88rem; color: var(--color-muted); line-height: 1.6;
  }

  /* ── Featured Research ── */
  .featured {
    background: rgba(94, 184, 157, 0.04);
    border: 1px solid rgba(94, 184, 157, 0.12);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 12px 12px 0;
    padding: 2rem 2rem 1.75rem;
    margin-bottom: 2rem;
  }
  .feat-tag {
    font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-accent); display: block; margin-bottom: 0.75rem;
  }
  .featured h3 {
    font-size: 1.15rem; color: var(--color-text); margin-bottom: 0.2rem;
  }
  .feat-advisor {
    font-size: 0.78rem; color: var(--color-faint); margin-bottom: 1rem;
  }
  .featured > p {
    font-size: 0.88rem; color: var(--color-muted); line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .feat-link {
    display: inline-block; margin-top: 0.5rem;
    font-size: 0.82rem; font-weight: 500; color: var(--color-accent);
  }

  /* ── Project Grid ── */
  .project-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 639px) { .project-grid { grid-template-columns: 1fr; } }

  .pcard {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    transition: border-color 200ms, background 200ms, transform 200ms;
  }
  .pcard:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }
  .pcard h3 {
    font-size: 0.92rem; color: var(--color-text); margin-bottom: 0.15rem;
  }
  .pcard-stack {
    font-family: var(--font-mono); font-size: 0.66rem;
    color: var(--color-faint); display: block; margin-bottom: 0.6rem;
  }
  .pcard p {
    font-size: 0.82rem; color: var(--color-muted); line-height: 1.5;
  }

  /* ── Press ── */
  .press {
    margin-top: 1.25rem; display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.78rem;
  }
  .press span { color: var(--color-faint); }

  /* ── About ── */
  .about-grid {
    display: grid; grid-template-columns: 1fr 220px; gap: 3rem;
  }
  @media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; gap: 2rem; } }

  .about-prose {
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .about-prose p {
    font-size: 0.88rem; color: var(--color-muted); line-height: 1.65; margin: 0;
  }
  .about-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
  .sb-block h4 {
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-faint); margin-bottom: 0.35rem;
  }
  .sb-block p {
    font-size: 0.8rem; color: var(--color-muted); line-height: 1.5;
  }
  .sb-block a { font-size: 0.8rem; }

  .closing {
    margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem; color: var(--color-muted);
    font-style: italic;
  }

  /* ── Footer ── */
  footer {
    padding: 2rem 1.5rem 2.5rem; max-width: 960px;
    margin: 0 auto; width: 100%;
  }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--color-border); padding-top: 1.5rem;
  }
  .footer-inner span { font-size: 0.75rem; color: var(--color-faint); }
  .footer-links { display: flex; gap: 1.25rem; }
  .footer-links a { font-size: 0.75rem; color: var(--color-faint); text-decoration: none; }
  .footer-links a:hover { color: var(--color-muted); }
</style>
