---
import Base from "../layouts/Base.astro";
---

<Base title="Prashant Shah">

<div class="page">
  <!-- NAV -->
  <nav>
    <span class="logo">PS</span>
    <div class="nav-links">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="/now" class="now-pill">Now &nearr;</a>
    </div>
  </nav>

  <!-- ═══ HERO CARD ═══ -->
  <section class="hero-card">
    <div class="hero-banner">
      <img src="/backgrounds/home.jpg" alt="" class="banner-img" />
    </div>
    <div class="hero-body">
      <div class="hero-info">
        <h1>Prashant Shah</h1>
        <p class="hero-tagline">22 &middot; Software Engineer &middot; Researcher</p>
        <p class="hero-status"><span class="status-dot"></span> Building my capstone, finishing research, looking for full-time roles</p>
      </div>
      <div class="hero-actions">
        <a href="mailto:shahp0021@gmail.com" class="btn">Get in touch</a>
        <a href="/resume.pdf" class="btn btn-outline">Resume</a>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ═══ -->
  <section class="card">
    <h2>About</h2>
    <div class="about-text">
      <p>I build software that closes the gap between what systems know and what people need. Every system I've built started with watching someone struggle with the one it replaced.</p>
      <p>Three languages before I was ten (Bengali, English, Hindi). CS & Data Science at Ramapo College, 3.84 GPA, graduating May 2026. Co-founded the CS club and convinced Bjarne Stroustrup to come speak.</p>
    </div>

    <!-- Letterboxd widget -->
    <div class="widget">
      <div class="widget-icon">🎬</div>
      <div class="widget-body">
        <span class="widget-label">Watching</span>
        <a href="https://letterboxd.com/_Prashant_/" target="_blank" rel="noopener noreferrer">Follow on Letterboxd &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══ CONNECT ═══ -->
  <section class="card">
    <h2>Connect</h2>
    <div class="connect-row">
      <a href="https://github.com/Prashant002-1" target="_blank" rel="noopener noreferrer" class="connect-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/prashant210/" target="_blank" rel="noopener noreferrer" class="connect-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a href="mailto:shahp0021@gmail.com" class="connect-pill">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        Email
      </a>
      <a href="https://letterboxd.com/_Prashant_/" target="_blank" rel="noopener noreferrer" class="connect-pill">🎬 Letterboxd</a>
    </div>
  </section>

  <!-- ═══ EXPERIENCE ═══ -->
  <section id="work" class="card">
    <h2>Experience</h2>
    <div class="exp-list">

      <div class="exp-item">
        <div class="exp-head">
          <h3>Trimble</h3>
          <span class="exp-type">Internship &middot; Summer 2025</span>
        </div>
        <p>Built a configuration management platform in C#/.NET and Azure. Single source of truth for a distributed broker architecture. Auth proxy through Azure Workload Identity Federation.</p>
        <div class="tags">
          <span>C#</span><span>.NET</span><span>Azure</span><span>Blazor</span><span>REST APIs</span>
        </div>
      </div>

      <div class="exp-item">
        <div class="exp-head">
          <h3>Novartis</h3>
          <span class="exp-type">Internship &middot; Summer 2024</span>
        </div>
        <p>Replaced a manual project proposal workflow. React/TypeScript app with Azure Functions. What took two days now took hours.</p>
        <div class="tags">
          <span>React</span><span>TypeScript</span><span>Azure Functions</span><span>PostgreSQL</span>
        </div>
      </div>

      <div class="exp-item">
        <div class="exp-head">
          <h3>Data Analyst &middot; Ramapo College</h3>
          <span class="exp-type">2023 &ndash; 2024</span>
        </div>
        <p>Python pipelines for 6,000+ student records. Automated data quality checks and reporting dashboards.</p>
        <div class="tags">
          <span>Python</span><span>SQL</span><span>Pandas</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ PROJECTS & RESEARCH ═══ -->
  <section id="projects" class="card">
    <h2>Projects & Research</h2>

    <!-- Featured research -->
    <div class="research-block">
      <span class="research-tag">Ongoing Research</span>
      <h3>Resolving Intent-Content Conflict in Retrieval</h3>
      <p class="research-advisor">With Dr. Ali Al-Juboori, Ramapo College</p>
      <p>What happens when someone wants a happy movie about war? Retrieval systems break. I'm building a framework that makes emotions first-class entities in a knowledge graph so the system can hold both ideas at once. 1,600 queries tested. The graph structure is doing real work.</p>
      <a href="https://github.com/Prashant002-1/knowledge-graph-retrieval-with-affective-grounding" target="_blank" rel="noopener noreferrer">See the code &rarr;</a>
    </div>

    <!-- Project grid -->
    <div class="proj-grid">
      <div class="proj-card">
        <h3>Canvas Agent</h3>
        <p>AI agent for my LMS. Nine tools, persistent memory, generative UI. Won HackRamapo.</p>
        <div class="tags"><span>TypeScript</span><span>Next.js</span><span>pgvector</span></div>
      </div>
      <div class="proj-card">
        <h3>Center for Food Action</h3>
        <p>Barcode-scanning inventory for pantry volunteers. One-handed iPad interface. 40,000 people served.</p>
        <div class="tags"><span>Flask</span><span>PostgreSQL</span></div>
      </div>
      <div class="proj-card">
        <h3>EmotionFlix</h3>
        <p>Emotion-based movie recs. On-device face scanning, 69 tests, no data leaves the browser.</p>
        <div class="tags"><span>React</span><span>Node.js</span></div>
      </div>
      <div class="proj-card">
        <h3>ADV Collision Risk</h3>
        <p>Capstone. Predicting which autonomous driving scenarios cause collisions. 33,530 scenarios.</p>
        <div class="tags"><span>XGBoost</span><span>scikit-learn</span></div>
      </div>
    </div>

    <div class="press-row">
      <span>Press:</span>
      <a href="https://newjersey.news12.com/ramapo-college-students-use-technology-to-streamline-food-pantry-operations" target="_blank" rel="noopener noreferrer">News 12 NJ</a>
      <a href="https://www.ramapo.edu/news/slide/real-world-impact-ramapo-developed-tech-to-revolutionize-food-banks/" target="_blank" rel="noopener noreferrer">Ramapo News</a>
    </div>
  </section>

  <!-- ═══ ABOUT EXTENDED ═══ -->
  <section id="about" class="card">
    <h2>More About Me</h2>
    <div class="about-grid">
      <div class="about-col">
        <p>I came to Ramapo for computer science and stayed because the scale let me do things. Managed 17 RAs and a community of 200+. Led the math club. Competed in ICPC at the New York regional.</p>
        <p>I want to be the kind of engineer who understands the system end to end: the data, the infrastructure, the interface, and the person on the other side of it.</p>
      </div>
      <div class="about-side-col">
        <div class="side-block">
          <h4>Education</h4>
          <p>BS CS & Data Science<br/>Minor in Mathematics<br/>Ramapo College, 3.84 GPA</p>
        </div>
        <div class="side-block">
          <h4>Awards</h4>
          <p>Canstruction 1st place<br/>Student Employee of the Year<br/>Presidential Scholarship (4 yrs)</p>
        </div>
      </div>
    </div>
    <!-- painted art as decorative accent -->
    <div class="art-strip">
      <img src="/backgrounds/home.jpg" alt="" />
      <img src="/backgrounds/now.jpg" alt="" />
      <img src="/backgrounds/about.jpg" alt="" />
    </div>
  </section>

  <!-- ═══ QUOTE ═══ -->
  <section class="quote-section">
    <blockquote>
      "Every system I've built started with watching someone struggle with the one it replaced."
    </blockquote>
  </section>

  <!-- ═══ FOOTER ═══ -->
  <footer>
    <span>&copy; 2026 Prashant Shah</span>
    <span class="footer-note">Built with care, not templates.</span>
  </footer>
</div>

</Base>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  /* ── Nav ── */
  nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 0; margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .logo { font-weight: 700; font-size: 1.1rem; color: var(--color-text); }
  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-links a { font-size: 0.82rem; font-weight: 500; color: var(--color-muted); }
  .nav-links a:hover { color: var(--color-text); }
  .now-pill {
    font-size: 0.75rem !important; font-weight: 500 !important;
    background: var(--color-accent-light); color: var(--color-accent) !important;
    padding: 0.3rem 0.75rem; border-radius: 99px;
  }

  /* ── Cards ── */
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    margin-bottom: 1rem;
  }
  .card h2 {
    font-size: 1.15rem; margin-bottom: 1rem; color: var(--color-text);
  }

  /* ── Hero Card ── */
  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .hero-banner {
    height: 160px; overflow: hidden; position: relative;
  }
  .banner-img {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.85) brightness(0.95);
  }
  .hero-body {
    padding: 1.5rem 2rem 1.75rem;
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
  }
  .hero-info h1 {
    font-size: 1.6rem; margin-bottom: 0.15rem;
  }
  .hero-tagline {
    font-size: 0.85rem; color: var(--color-muted); margin-bottom: 0.5rem;
  }
  .hero-status {
    font-size: 0.78rem; color: var(--color-muted);
    display: flex; align-items: center; gap: 0.4rem;
  }
  .status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #7BB86F; display: inline-block;
    box-shadow: 0 0 6px rgba(123, 184, 111, 0.4);
  }
  .hero-actions { display: flex; gap: 0.5rem; flex-shrink: 0; align-self: center; }

  .btn {
    font-size: 0.78rem; font-weight: 600;
    background: var(--color-accent); color: white;
    padding: 0.5rem 1.2rem; border-radius: 8px;
    text-decoration: none; transition: background 150ms;
  }
  .btn:hover { background: var(--color-accent-hover); color: white; }
  .btn-outline {
    background: transparent; color: var(--color-muted);
    border: 1px solid var(--color-border);
  }
  .btn-outline:hover { border-color: var(--color-text); color: var(--color-text); background: transparent; }

  /* ── About ── */
  .about-text { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem; }
  .about-text p { font-size: 0.88rem; color: var(--color-muted); line-height: 1.6; margin: 0; }

  /* ── Widget ── */
  .widget {
    display: flex; align-items: center; gap: 0.75rem;
    background: var(--color-accent-light);
    border: 1px solid var(--color-border);
    border-radius: 10px; padding: 0.75rem 1rem;
  }
  .widget-icon { font-size: 1.4rem; }
  .widget-label { font-size: 0.72rem; color: var(--color-faint); display: block; }
  .widget-body a { font-size: 0.82rem; font-weight: 500; }

  /* ── Connect ── */
  .connect-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .connect-pill {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; font-weight: 500; color: var(--color-muted);
    border: 1px solid var(--color-border); border-radius: 8px;
    padding: 0.45rem 0.9rem; text-decoration: none;
    transition: border-color 150ms, color 150ms;
  }
  .connect-pill:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .connect-pill svg { flex-shrink: 0; }

  /* ── Experience ── */
  .exp-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .exp-item {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .exp-item:last-child { border-bottom: none; padding-bottom: 0; }
  .exp-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.3rem; }
  .exp-head h3 { font-size: 0.95rem; }
  .exp-type { font-size: 0.72rem; color: var(--color-faint); white-space: nowrap; }
  .exp-item > p { font-size: 0.85rem; color: var(--color-muted); line-height: 1.55; margin-bottom: 0.6rem; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tags span {
    font-size: 0.68rem; font-family: var(--font-mono);
    color: var(--color-muted); background: var(--color-accent-light);
    padding: 0.2rem 0.55rem; border-radius: 5px;
  }

  /* ── Research ── */
  .research-block {
    background: var(--color-accent-light);
    border: 1px solid rgba(139, 94, 131, 0.15);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 10px 10px 0;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .research-tag {
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-accent);
    display: block; margin-bottom: 0.5rem;
  }
  .research-block h3 { font-size: 1rem; margin-bottom: 0.15rem; }
  .research-advisor { font-size: 0.75rem; color: var(--color-faint); margin-bottom: 0.75rem; }
  .research-block > p { font-size: 0.85rem; color: var(--color-muted); line-height: 1.55; margin-bottom: 0.5rem; }
  .research-block a { font-size: 0.82rem; font-weight: 500; }

  /* ── Project Grid ── */
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  @media (max-width: 560px) { .proj-grid { grid-template-columns: 1fr; } }

  .proj-card {
    border: 1px solid var(--color-border); border-radius: 10px;
    padding: 1rem 1.25rem;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .proj-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 12px rgba(139, 94, 131, 0.08);
  }
  .proj-card h3 { font-size: 0.88rem; margin-bottom: 0.3rem; }
  .proj-card p { font-size: 0.78rem; color: var(--color-muted); line-height: 1.45; margin-bottom: 0.5rem; }

  .press-row {
    margin-top: 1rem; display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.75rem;
  }
  .press-row span { color: var(--color-faint); }

  /* ── About Extended ── */
  .about-grid {
    display: grid; grid-template-columns: 1fr 200px; gap: 2rem;
  }
  @media (max-width: 600px) { .about-grid { grid-template-columns: 1fr; } }
  .about-col { display: flex; flex-direction: column; gap: 0.6rem; }
  .about-col p { font-size: 0.85rem; color: var(--color-muted); line-height: 1.6; margin: 0; }
  .about-side-col { display: flex; flex-direction: column; gap: 1.25rem; }
  .side-block h4 {
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-faint); margin-bottom: 0.25rem;
  }
  .side-block p { font-size: 0.78rem; color: var(--color-muted); line-height: 1.45; }

  .art-strip {
    display: flex; gap: 0.5rem; margin-top: 1.5rem;
    border-top: 1px solid var(--color-border); padding-top: 1.25rem;
  }
  .art-strip img {
    flex: 1; height: 80px; object-fit: cover; border-radius: 8px;
    filter: saturate(0.8);
  }

  /* ── Quote ── */
  .quote-section {
    text-align: center; padding: 2.5rem 1rem;
  }
  .quote-section blockquote {
    font-size: 0.95rem; font-style: italic;
    color: var(--color-muted); max-width: 480px; margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Footer ── */
  footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.5rem 0; border-top: 1px solid var(--color-border);
    font-size: 0.72rem; color: var(--color-faint);
  }
  .footer-note { font-style: italic; }
</style>
