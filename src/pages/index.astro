<script>
import Lenis from 'lenis';

const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
setTimeout(() => {
  document.querySelectorAll('#hero .reveal').forEach(el => el.classList.add('visible'));
}, 100);

const orbNavEl = document.getElementById('orbNav');
const orbTriggerEl = document.getElementById('orbTrigger');
const orbMenuEl = document.getElementById('orbMenu');
const orbHeroAnchor = document.getElementById('orbHeroAnchor');
const heroSection = document.getElementById('hero');

function positionOrb() {
  if (!orbNavEl) return;
  const heroRect = heroSection?.getBoundingClientRect();
  const anchorRect = orbHeroAnchor?.getBoundingClientRect();
  const canUseHeroAnchor = anchorRect && anchorRect.width > 0;
  const heroInView = canUseHeroAnchor && heroRect && heroRect.bottom > window.innerHeight * 0.28 && heroRect.top < window.innerHeight * 0.78;

  if (heroInView) {
    orbNavEl.classList.add('hero-mode');
    orbNavEl.style.setProperty('--orb-x', `${anchorRect.left + anchorRect.width / 2 - 17}px`);
    orbNavEl.style.setProperty('--orb-y', `${anchorRect.top + anchorRect.height / 2 - 17}px`);
  } else {
    orbNavEl.classList.remove('hero-mode');
    orbNavEl.style.setProperty('--orb-x', `${window.innerWidth - 68}px`);
    orbNavEl.style.setProperty('--orb-y', '34px');
  }
}

positionOrb();
requestAnimationFrame(positionOrb);
requestAnimationFrame(() => requestAnimationFrame(positionOrb));
window.addEventListener('load', positionOrb);
document.fonts?.ready?.then(positionOrb);
setTimeout(positionOrb, 250);
window.addEventListener('scroll', positionOrb, { passive: true });
window.addEventListener('resize', positionOrb);

const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
let lenis = null;
let lenisFrame = 0;

function startWeightedScroll() {
  if (lenis || reducedMotion.matches) return;
  lenis = new Lenis({
    lerp: 0.12,
    wheelMultiplier: 1,
    anchors: true,
    syncTouch: false,
    smoothWheel: true,
    stopInertiaOnNavigate: true,
  });
  lenis.on('scroll', positionOrb);

  function raf(time) {
    if (!lenis) return;
    lenis.raf(time);
    lenisFrame = requestAnimationFrame(raf);
  }

  lenisFrame = requestAnimationFrame(raf);
}

function stopWeightedScroll() {
  if (!lenis) return;
  window.cancelAnimationFrame(lenisFrame);
  lenis.destroy();
  lenis = null;
  lenisFrame = 0;
  positionOrb();
}

startWeightedScroll();
reducedMotion.addEventListener('change', e => {
  if (e.matches) stopWeightedScroll();
  else startWeightedScroll();
});

const cursorDot = document.getElementById('cursorDot');
const cursorRing = document.getElementById('cursorRing');
if (!window.matchMedia('(hover: none)').matches) {
  let mx = 0, my = 0, rx = 0, ry = 0;
  let ringFrame = 0;
  let lastMove = 0;
  function animRing() {
    rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
    cursorRing.style.left = rx + 'px'; cursorRing.style.top = ry + 'px';
    const settled = Math.abs(mx - rx) < 0.15 && Math.abs(my - ry) < 0.15;
    if (settled && performance.now() - lastMove > 1200) { ringFrame = 0; return; }
    ringFrame = requestAnimationFrame(animRing);
  }
  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    lastMove = performance.now();
    cursorDot.style.left = mx + 'px'; cursorDot.style.top = my + 'px';
    if (!ringFrame) ringFrame = requestAnimationFrame(animRing);
  });
  function setCursor(ringClass, dotClass) {
    cursorRing.className = 'cursor-ring' + (ringClass ? ' ' + ringClass : '');
    cursorDot.className  = 'cursor-dot'  + (dotClass  ? ' ' + dotClass  : '');
  }
  function bindCursor(selector, ringClass, dotClass) {
    document.querySelectorAll(selector).forEach(el => {
      el.addEventListener('mouseenter', () => setCursor(ringClass, dotClass));
      el.addEventListener('mouseleave', () => setCursor('', ''));
    });
  }
  bindCursor('.hero-name-row', 'cur-lens', 'cur-lens');
  bindCursor('.github-heatmap', 'cur-grid', 'cur-grid');
  bindCursor('.work-card, .work-featured', 'cur-expand', 'cur-expand');
  document.querySelectorAll('.card-expand-btn').forEach(btn => {
    btn.addEventListener('mouseenter', () => setCursor('cur-close', 'cur-close'));
    btn.addEventListener('mouseleave', () => setCursor('cur-expand', 'cur-expand'));
  });
  bindCursor('.stat-value, .research-stat', 'cur-square', 'cur-square');
  bindCursor('.cta-primary, .cta-secondary', 'cur-cta', 'cur-cta');
  bindCursor('a[target="_blank"]', 'cur-arrow', 'cur-arrow');
  bindCursor('.now-item', 'cur-live', 'cur-live');

  const orbNav = orbNavEl;
  const orbTrigger = orbTriggerEl;
  const orbMenu = orbMenuEl;
  if (orbNav && orbTrigger && orbMenu) {
    let absorbed = false;
    let collapseTimer = null;

    function openOrb() {
      if (collapseTimer) window.clearTimeout(collapseTimer);
      absorbed = true;
      orbNav.classList.add('open');
      orbNav.classList.remove('pulling', 'collapsing');
      orbNav.style.setProperty('--pull-x', '0px');
      orbNav.style.setProperty('--pull-y', '0px');
      orbTrigger.setAttribute('aria-expanded', 'true');
      setCursor('cur-orb', 'cur-orb');
    }

    function closeOrb() {
      absorbed = false;
      orbNav.classList.add('collapsing');
      orbNav.classList.remove('open', 'pulling');
      orbNav.style.setProperty('--pull-x', '0px');
      orbNav.style.setProperty('--pull-y', '0px');
      orbTrigger.setAttribute('aria-expanded', 'false');
      if (orbNav.contains(document.activeElement)) document.activeElement.blur();
      setCursor('', '');
      if (collapseTimer) window.clearTimeout(collapseTimer);
      collapseTimer = window.setTimeout(() => orbNav.classList.remove('collapsing'), 170);
    }

    let magnetEvent = null;
    let magnetFrame = 0;

    function processMagnet() {
      magnetFrame = 0;
      const e = magnetEvent;
      if (!e) return;

      if (absorbed) {
        const menuRect = orbMenu.getBoundingClientRect();
        const navRect = orbNav.getBoundingClientRect();
        const cx = navRect.left + navRect.width / 2;
        const cy = navRect.top + navRect.height / 2;
        const outsideMenu =
          e.clientX < menuRect.left - 40 ||
          e.clientX > menuRect.right + 40 ||
          e.clientY < menuRect.top - 40 ||
          e.clientY > menuRect.bottom + 40;

        if (outsideMenu && Math.hypot(e.clientX - cx, e.clientY - cy) > 190) closeOrb();
        return;
      }

      const r = orbNav.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const dist = Math.hypot(dx, dy);

      if (dist < 118) {
        const strength = Math.max(0, 1 - dist / 118);
        orbNav.classList.add('pulling');
        orbNav.style.setProperty('--pull-x', `${dx * strength * 0.72}px`);
        orbNav.style.setProperty('--pull-y', `${dy * strength * 0.72}px`);
        setCursor('cur-orb', 'cur-orb');
        if (dist < 26) openOrb();
      } else {
        orbNav.classList.remove('pulling');
        orbNav.style.setProperty('--pull-x', '0px');
        orbNav.style.setProperty('--pull-y', '0px');
      }
    }

    document.addEventListener('mousemove', e => {
      magnetEvent = e;
      if (!magnetFrame) magnetFrame = requestAnimationFrame(processMagnet);
    });

    orbTrigger.addEventListener('click', () => {
      if (orbNav.classList.contains('open')) closeOrb();
      else openOrb();
    });

    document.addEventListener('click', e => {
      if (!orbNav.contains(e.target)) closeOrb();
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeOrb();
    });

    orbMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setTimeout(closeOrb, 120));
    });
  }
}

if (window.matchMedia('(hover: none)').matches) {
  const orbNav = orbNavEl;
  const orbTrigger = orbTriggerEl;
  const orbMenu = orbMenuEl;

  if (orbNav && orbTrigger && orbMenu) {
    function closeTouchOrb() {
      orbNav.classList.remove('open');
      orbTrigger.setAttribute('aria-expanded', 'false');
      if (orbNav.contains(document.activeElement)) document.activeElement.blur();
    }

    orbTrigger.addEventListener('click', () => {
      const isOpen = orbNav.classList.toggle('open');
      orbTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (!isOpen) orbTrigger.blur();
    });

    document.addEventListener('click', e => {
      if (!orbNav.contains(e.target)) closeTouchOrb();
    });

    orbMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setTimeout(closeTouchOrb, 120));
    });
  }
}

document.querySelectorAll('.cta-primary, .cta-secondary').forEach(el => {
  el.addEventListener('mousemove', e => {
    const r = el.getBoundingClientRect();
    const dx = (e.clientX - (r.left + r.width / 2)) * 0.28;
    const dy = (e.clientY - (r.top + r.height / 2)) * 0.28;
    el.style.transform = `translate(${dx}px,${dy}px)`;
  });
  el.addEventListener('mouseleave', () => { el.style.transform = 'translate(0,0)'; });
});

const navLinks = document.querySelectorAll('.orb-menu a[href^="#"]');
if (navLinks.length) {
  const navObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });

  document.querySelectorAll('section[id]').forEach(s => navObserver.observe(s));
}

document.querySelectorAll('.card-expand-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const card = btn.closest('.work-card, .work-featured');
    const isOpen = card.classList.toggle('expanded');
    const label = btn.querySelector('.exp-label');
    if (label) label.textContent = isOpen ? 'less' : 'more detail';
  });
});

function countUp(el, target, duration) {
  const isFloat = target < 1;
  let start = null;
  el.classList.add('counting');
  function step(ts) {
    if (!start) start = ts;
    const p = Math.min((ts - start) / duration, 1);
    const ease = 1 - Math.pow(1 - p, 3);
    el.textContent = isFloat ? (target * ease).toFixed(3) : Math.floor(target * ease).toLocaleString();
    if (p < 1) requestAnimationFrame(step); else el.classList.remove('counting');
  }
  requestAnimationFrame(step);
}
let statsFired = false;
const statEls = document.querySelectorAll('.research-stat .stat-value');
new IntersectionObserver(entries => {
  if (!statsFired && entries.some(e => e.isIntersecting)) {
    statsFired = true;
    if (statEls[0]) countUp(statEls[0], 1600, 1400);
  }
}, { threshold: 0.5 }).observe(statEls[0] || document.body);

const clockEl = document.getElementById('stripClock');
function tick() {
  if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
}
tick(); setInterval(tick, 1000);
</script>

</body>
</html>
