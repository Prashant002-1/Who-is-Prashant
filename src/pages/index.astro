      footer { padding: 40px 24px 72px; grid-template-columns: 1fr; gap: 28px; }
      .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #now-strip { padding: 0 24px; gap: 12px; font-size: 10px; }
    }
  </style>
</head>
