<script>
  import('../scripts/line-study.js').then(({ startLineStudy }) => startLineStudy(document.getElementById('line-study'))).catch(() => {});

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.site-nav a');
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const sectionId = entry.target.id === 'about' ? 'experience' : entry.target.id === 'other-work' ? 'work' : entry.target.id;
      for (const link of navLinks) {
        if (link.hash === `#${sectionId}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    }
  }, { rootMargin: '-10% 0px -65% 0px' });
  document.querySelectorAll('main section[id]').forEach(section => observer.observe(section));

  const clockEl = document.getElementById('stripClock');
  function tick() {
    if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  }
  tick();
  const clock = setInterval(tick, 1000);

  window.addEventListener('pagehide', (event) => {
    if (event.persisted) return;
    observer.disconnect();
    clearInterval(clock);
  }, { once: true });
</script>
