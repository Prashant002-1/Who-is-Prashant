---
import Base from "../../layouts/Base.astro";
---

<Base title="Thinking | Prashant Shah" bg="thinking">
  <header class="page-header reveal">
    <h1 transition:name="page-title">Thinking</h1>
    <p class="lede">Short writing on problems I've worked through and how I reasoned about them.</p>
  </header>
</Base>

<style>
  .page-header {
    padding-top: 2rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }

  .lede {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
