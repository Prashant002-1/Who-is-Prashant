---
import Base from "../layouts/Base.astro";
---

<Base title="Now | Prashant Shah">
  <h1 class="text-[clamp(1.8rem,4vw,2.4rem)] mb-2" transition:name="page-title">Now</h1>
  <p class="text-[13px] text-[var(--color-faint)] mb-12">Last updated April 2026</p>

  <div class="space-y-10">

    <section>
      <h2 class="text-[14px] font-semibold uppercase tracking-wide text-[var(--color-faint)] mb-3">Building</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
        Finishing my capstone on collision risk prediction in autonomous driving simulations, and wrapping up the pantry inventory system for the Center for Food Action.
      </p>
    </section>

    <section>
      <h2 class="text-[14px] font-semibold uppercase tracking-wide text-[var(--color-faint)] mb-3">Researching</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
        Resolving intent-content conflict in retrieval. What happens when a user's emotional intent contradicts the semantics of what they're searching for.
      </p>
    </section>

    <section>
      <h2 class="text-[14px] font-semibold uppercase tracking-wide text-[var(--color-faint)] mb-3">Learning</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
        Graph Transformers and how structured knowledge can make retrieval systems smarter than embeddings alone.
      </p>
    </section>

    <section>
      <h2 class="text-[14px] font-semibold uppercase tracking-wide text-[var(--color-faint)] mb-3">Watching</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
        Tracking on <a href="https://letterboxd.com/_Prashant_/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)]">Letterboxd</a>.
      </p>
    </section>

    <section>
      <h2 class="text-[14px] font-semibold uppercase tracking-wide text-[var(--color-faint)] mb-3">Looking for</h2>
      <p class="text-[15px] text-[var(--color-muted)] leading-relaxed">
        Full-time software engineering, AI/ML, or data roles starting Summer 2026.
      </p>
    </section>

  </div>
</Base>
