---
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/work", label: "Work" },
  { href: "/research", label: "Research" },
  { href: "/thinking", label: "Thinking" },
  { href: "/now", label: "Now" },
  { href: "/about", label: "About" },
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<nav class="border-b border-[var(--color-border)]">
  <div class="mx-auto flex max-w-[960px] items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-heading text-lg font-semibold tracking-tight text-[var(--color-text)] no-underline"
    >
      Prashant Shah
    </a>
    <ul class="flex gap-6 text-[0.9rem]">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              "no-underline transition-colors duration-150",
              isActive(href)
                ? "text-[var(--color-accent)] font-medium"
                : "text-[var(--color-muted)] hover:text-[var(--color-text)]",
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
