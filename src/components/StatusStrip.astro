<style>
  #now-strip {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
    height: 38px; border-top: 1px solid var(--color-border);
    background: var(--color-strip);
    display: flex; align-items: center; padding: 0 48px; gap: 18px;
    font-size: var(--text-caption); line-height: var(--leading-label); color: var(--color-muted);
    letter-spacing: 0;
  }
  .strip-item { min-width: 0; display: flex; align-items: center; gap: 9px; white-space: nowrap; }
  .building-item { flex: 1 1 330px; }
  .recognition-item { flex: 1 1 300px; }
  .watching-item { flex: 0 1 190px; }
  .strip-label { color: var(--color-muted); }
  .strip-value { min-width: 0; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; }
  .strip-ticker {
    display: block; position: relative; min-width: 0; max-width: 100%;
    overflow: hidden; text-overflow: clip;
  }
  .strip-ticker-track {
    display: inline-flex; gap: 36px; min-width: max-content;
    transform: translateX(0); will-change: transform;
    animation: strip-ticker 24s linear infinite;
  }
  #now-strip:hover .strip-ticker-track, #now-strip:focus-within .strip-ticker-track { animation-play-state: paused; }
  @keyframes strip-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 18px)); }
  }
  .strip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-faint);
    flex: 0 0 auto;
  }
  .strip-sep { color: var(--color-border); font-size: var(--text-small); flex: 0 0 auto; }
  .strip-social-icons { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .strip-social-icons a {
    width: 16px; height: 16px; display: grid; place-items: center;
    color: var(--color-faint); text-decoration: none;
    transition: color var(--transition), transform 200ms ease;
  }
  .strip-social-icons a:hover { color: var(--color-text); transform: translateY(-2px); }
  .strip-social-icons svg { width: 12px; height: 12px; display: block; }
  .strip-clock { margin-left: auto; color: var(--color-faint); min-width: 66px; text-align: right; font-variant-numeric: tabular-nums; }

  @media (min-width: 1280px) {
    #now-strip { padding-left: clamp(48px, 6vw, 96px); }
  }
  @media (max-width: 1024px) {
    #now-strip { padding: 0 32px; gap: 14px; }
    .recognition-item, .recognition-sep { display: none; }
  }
  @media (max-width: 768px) {
    #now-strip { height: 48px; padding: 0 18px; gap: 10px; }
    .recognition-item, .watching-item, .strip-sep, .strip-clock { display: none; }
    .strip-item { gap: 7px; }
    .strip-value { max-width: 42vw; line-height: 1.25; }
    .strip-social-icons { margin-left: auto; gap: 8px; }
    .strip-social-icons a { width: 22px; height: 22px; }
  }
  @media (max-width: 520px) {
    .strip-label { display: none; }
    .strip-value { display: none; }
    .strip-social-icons { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-dot, .strip-ticker-track { animation: none !important; }
  }
</style>

<script>
  const clockEl = document.getElementById('stripClock');
  function tick() {
    if (clockEl) clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  }
  tick();
  const clock = setInterval(tick, 1000);

  window.addEventListener('pagehide', (event) => {
    if (event.persisted) return;
    clearInterval(clock);
  }, { once: true });
</script>
