---
interface Props {
  slug?: string;
}

const { slug = "home" } = Astro.props;

const imageUrl = `/backgrounds/${slug}.jpg`;

const fallbacks: Record<string, string> = {
  home: "radial-gradient(ellipse 120% 80% at 50% 100%, rgba(88, 72, 58, 0.45) 0%, transparent 55%), radial-gradient(ellipse 90% 60% at 20% 15%, rgba(120, 90, 140, 0.35) 0%, transparent 50%), linear-gradient(165deg, #141018 0%, #1c1822 40%, #121016 100%)",
  now: "radial-gradient(ellipse 100% 70% at 50% 110%, rgba(180, 120, 90, 0.25) 0%, transparent 50%), radial-gradient(ellipse 80% 50% at 70% 10%, rgba(70, 60, 110, 0.4) 0%, transparent 45%), linear-gradient(180deg, #0e0c12 0%, #161420 55%, #1a1418 100%)",
  work: "radial-gradient(ellipse 110% 70% at 50% 0%, rgba(160, 120, 70, 0.2) 0%, transparent 50%), linear-gradient(165deg, #151218 0%, #1a161c 100%)",
  projects: "radial-gradient(ellipse 90% 60% at 50% 100%, rgba(50, 70, 95, 0.35) 0%, transparent 55%), linear-gradient(175deg, #0f1218 0%, #16141a 100%)",
  thinking: "radial-gradient(ellipse 100% 80% at 50% 30%, rgba(90, 75, 110, 0.25) 0%, transparent 60%), linear-gradient(180deg, #121016 0%, #18141c 100%)",
  research: "radial-gradient(ellipse 80% 55% at 30% 20%, rgba(100, 80, 130, 0.3) 0%, transparent 50%), linear-gradient(170deg, #100e14 0%, #16121a 100%)",
  about: "radial-gradient(ellipse 100% 70% at 50% 100%, rgba(70, 95, 75, 0.22) 0%, transparent 55%), radial-gradient(ellipse 70% 50% at 80% 15%, rgba(130, 100, 70, 0.15) 0%, transparent 45%), linear-gradient(165deg, #121410 0%, #16141a 100%)",
};

const fallback = fallbacks[slug] ?? fallbacks.home;
---

<div class="scene-root" aria-hidden="true">
  <div class="scene-fallback" style={`background: ${fallback}`}></div>
  <div
    class="scene-photo"
    style={`background-image: url('${imageUrl}')`}
    data-scene-layer="photo"
  ></div>
  <div class="scene-warmth" data-scene-layer="warmth"></div>
  <div class="scene-vignette" data-scene-layer="vignette"></div>
  <div class="scene-grain"></div>
</div>

<style>
  .scene-root {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .scene-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .scene-photo {
    position: absolute;
    inset: -8%;
    z-index: 1;
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0.92;
    transform: translate3d(
        calc(var(--pointer-x, 0) * 12px),
        calc(var(--pointer-y, 0) * 10px),
        0
      )
      scale(1.06);
    will-change: transform;
  }

  .scene-warmth {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(18, 14, 22, 0.25) 0%,
      rgba(12, 10, 16, 0.55) 45%,
      rgba(8, 7, 12, 0.78) 100%
    );
    mix-blend-mode: multiply;
    transform: translate3d(
      calc(var(--pointer-x, 0) * -6px),
      calc(var(--pointer-y, 0) * -4px),
      0
    );
  }

  .scene-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse 85% 75% at 50% 45%,
      transparent 0%,
      rgba(5, 4, 8, 0.5) 70%,
      rgba(3, 2, 5, 0.92) 100%
    );
    transform: translate3d(
      calc(var(--pointer-x, 0) * 4px),
      calc(var(--pointer-y, 0) * 3px),
      0
    );
  }

  .scene-grain {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.07;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-photo,
    .scene-warmth,
    .scene-vignette {
      transform: none !important;
    }
  }
</style>
