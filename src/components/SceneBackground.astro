---
interface Props {
  page: string;
}

const { page } = Astro.props;

const gradients: Record<string, string> = {
  home:     "radial-gradient(ellipse at 60% 30%, #112b24 0%, #0a1a16 40%, #09090f 100%)",
  work:     "radial-gradient(ellipse at 30% 60%, #0f1f17 0%, #0a1410 40%, #09090f 100%)",
  research: "radial-gradient(ellipse at 50% 20%, #0a1a1e 0%, #06101a 45%, #09090f 100%)",
  now:      "radial-gradient(ellipse at 40% 40%, #101a14 0%, #0a120e 45%, #09090f 100%)",
  about:    "radial-gradient(ellipse at 50% 60%, #0d1a14 0%, #080f0d 45%, #09090f 100%)",
};

const gradient = gradients[page] ?? gradients.home;
const imagePath = `/backgrounds/${page}.jpg`;
---

<div
  class="scene-gradient"
  style={`background: ${gradient};`}
  aria-hidden="true"
/>
<div
  class="scene-image"
  style={`background-image: url('${imagePath}'), ${gradient};`}
  aria-hidden="true"
/>

<style>
  .scene-gradient,
  .scene-image {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .scene-gradient {
    z-index: -2;
  }

  .scene-image {
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.35;
  }
</style>
