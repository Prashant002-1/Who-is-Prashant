---
interface Props {
  page: string;
  video?: boolean;
}

const { page, video = false } = Astro.props;

const gradients: Record<string, string> = {
  home:     "radial-gradient(ellipse at 60% 30%, #2d1b69 0%, #0f0a2e 45%, #09090f 100%)",
  work:     "radial-gradient(ellipse at 30% 60%, #1a1000 0%, #0d0a1e 40%, #09090f 100%)",
  projects: "radial-gradient(ellipse at 50% 20%, #0a1a3e 0%, #06101f 45%, #09090f 100%)",
  thinking: "radial-gradient(ellipse at 70% 80%, #1a0d2e 0%, #0b0718 45%, #09090f 100%)",
  now:      "radial-gradient(ellipse at 40% 40%, #1a0a1a 0%, #100820 45%, #09090f 100%)",
  about:    "radial-gradient(ellipse at 50% 60%, #0d1a0d 0%, #080f12 45%, #09090f 100%)",
};

const gradient = gradients[page] ?? gradients.home;
const imagePath = `/backgrounds/${page}.jpg`;
const videoPath = `/backgrounds/${page}.mp4`;
---

<div
  class="scene-gradient"
  style={`background: ${gradient};`}
  aria-hidden="true"
/>

{video ? (
  <video
    class="scene-video"
    src={videoPath}
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  />
) : (
  <div
    class="scene-image"
    style={`background-image: url('${imagePath}'), ${gradient};`}
    aria-hidden="true"
  />
)}

<style>
  .scene-gradient,
  .scene-image,
  .scene-video {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .scene-gradient {
    z-index: -2;
  }

  .scene-image {
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .scene-video {
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
