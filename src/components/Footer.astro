---
const links = [
  { href: "https://github.com/Prashant002-1", label: "GitHub" },
  { href: "https://www.linkedin.com/in/prashant210/", label: "LinkedIn" },
  { href: "mailto:shahp0021@gmail.com", label: "Email" },
];
---

<footer>
  <div class="inner">
    <span class="copy">&copy; 2026 Prashant Shah</span>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            target={href.startsWith("mailto") ? undefined : "_blank"}
            rel={href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 1.5rem 2.5rem;
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .copy {
    font-size: 0.8rem;
    color: var(--color-faint);
  }

  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-size: 0.8rem;
    color: var(--color-faint);
    text-decoration: none;
    transition: color 150ms ease;
  }

  ul a:hover {
    color: var(--color-muted);
  }
</style>
