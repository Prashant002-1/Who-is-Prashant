---
const links = [
  { href: "https://github.com/prashantshah", label: "GitHub" },
  { href: "https://linkedin.com/in/prashantshah", label: "LinkedIn" },
  { href: "mailto:hello@prashantshah.dev", label: "Email" },
];
---

<footer>
  <div class="inner glass">
    <span class="name">Prashant Shah</span>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            target={href.startsWith("mailto") ? undefined : "_blank"}
            rel={href.startsWith("mailto") ? undefined : "noopener noreferrer"}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 1.5rem 3rem;
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.75rem;
  }

  .name {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  ul a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
